---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || '';
---

<StarlightPage frontmatter={{ title: 'Get your license', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash">
    <section class="license-header">
      <h1>Get your RTMX Sync license</h1>
      <p class="license-subtitle">
        A license file entitles one organization to shared, tenant-isolated RTM
        rooms on your rtmx-sync server. The RTMX CLI stays free under Apache 2.0
        and never checks a license.
      </p>
    </section>

    <section class="license-form-section not-content">
      <form id="license-form" class="license-form" novalidate>
        <label class="field">
          <span class="field-label">Your rtmx-sync server</span>
          <input
            type="url"
            id="server-url"
            name="server-url"
            class="text-input"
            placeholder="https://sync.example.com"
            value={defaultServer}
            required
          />
          <span class="field-help">The server that will enforce the license.</span>
        </label>

        <label class="field">
          <span class="field-label">Organization</span>
          <input
            type="text"
            id="org-ref"
            name="org-ref"
            class="text-input"
            placeholder="acme"
            required
          />
          <span class="field-help">Org slug or id, as shown in your dashboard.</span>
        </label>

        <label class="field">
          <span class="field-label">Admin API key</span>
          <input
            type="password"
            id="api-key"
            name="api-key"
            class="text-input"
            placeholder="rtmx_ad_..."
            required
            autocomplete="off"
          />
          <span class="field-help">
            Created with <code>rtmx_ad_</code> admin scope. It is sent only to the
            server above and is never stored by this page.
          </span>
        </label>

        <label class="field">
          <span class="field-label">Tier</span>
          <select id="tier" name="tier" class="text-input">
            <option value="team">Team</option>
            <option value="free">Free</option>
          </select>
          <span class="field-help">
            Enterprise and On-Prem terms are negotiated; <a href="/contact">contact sales</a>.
          </span>
        </label>

        <button type="submit" class="submit-button" id="license-submit">
          <span class="button-text">Issue and download</span>
        </button>
      </form>

      <div class="form-message" id="license-message" role="status" aria-live="polite"></div>
    </section>

    <section class="install-section">
      <h2>Install it</h2>
      <ol class="install-steps">
        <li>Save the downloaded <code>license.json</code> on the server host.</li>
        <li>
          Point the server at it with <code>RTMX_LICENSE_FILE=/etc/rtmx-sync/license.json</code>
          and set <code>RTMX_ENTITLEMENT_MODE=enforce</code>.
        </li>
        <li>
          Trust the issuer with <code>RTMX_LICENSE_TRUSTED_KEYS</code>, whose value is
          published by your server at <code>/licenses/signing-key</code>.
        </li>
        <li>No restart required. The next write picks up the new license.</li>
      </ol>
      <p class="install-note">
        Air-gapped? The same file works offline. Validation is Ed25519 signature
        checking against a key you configure; the server makes no outbound calls.
      </p>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page {
    background: var(--rtmx-bg);
    min-height: 100vh;
    width: 100%;
  }

  .license-header {
    text-align: center;
    padding: 1.5rem 2rem 0.75rem;
  }

  .license-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .license-subtitle {
    font-size: 1.1rem;
    color: var(--rtmx-text-muted);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .license-form-section {
    max-width: 560px;
    margin: 0 auto;
    padding: 2rem;
  }

  .license-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field-label {
    color: var(--rtmx-text);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .field-help {
    color: var(--rtmx-text-dim);
    font-size: 0.85rem;
  }

  .text-input {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--rtmx-border-hover);
    background: var(--rtmx-bg-card);
    color: var(--rtmx-text);
    font-size: 1rem;
    font-family: inherit;
  }

  .text-input:focus {
    outline: none;
    border-color: var(--rtmx-emerald);
  }

  .text-input[aria-invalid='true'] {
    border-color: #f43f5e;
  }

  .license-form .submit-button {
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    border: none;
    background: var(--rtmx-emerald);
    color: var(--rtmx-bg);
    font-weight: 600;
    font-size: 1rem;
    font-family: inherit;
    cursor: pointer;
  }

  .license-form .submit-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .install-section {
    max-width: 700px;
    margin: 0 auto;
    padding: 1rem 2rem 4rem;
  }

  .install-section h2 {
    font-size: 1.5rem;
    color: var(--rtmx-text);
    margin: 0 0 1rem 0;
  }

  .install-steps {
    color: var(--rtmx-text-muted);
    line-height: 1.8;
  }

  .install-note {
    color: var(--rtmx-text-dim);
    font-size: 0.9rem;
  }
</style>

<script>
  const form = document.getElementById('license-form') as HTMLFormElement;
  const serverInput = document.getElementById('server-url') as HTMLInputElement;
  const orgInput = document.getElementById('org-ref') as HTMLInputElement;
  const keyInput = document.getElementById('api-key') as HTMLInputElement;
  const tierSelect = document.getElementById('tier') as HTMLSelectElement;
  const submitBtn = document.getElementById('license-submit') as HTMLButtonElement;
  const message = document.getElementById('license-message') as HTMLDivElement;

  function show(text: string, kind: 'success' | 'error') {
    message.textContent = text;
    message.className = `form-message is-${kind}`;
  }

  function explain(status: number, body: string): string {
    if (status === 401) return 'The server did not recognize that API key.';
    if (status === 403) return 'That key is not an admin credential for this organization.';
    if (status === 404) return 'That organization does not exist on this server.';
    if (status === 400) return body || 'That tier is not self-service. Contact sales.';
    return body || `Server returned ${status}.`;
  }

  function downloadLicense(envelope: unknown) {
    const blob = new Blob([JSON.stringify(envelope, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'license.json';
    anchor.click();
    URL.revokeObjectURL(url);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const server = serverInput.value.trim().replace(/\/+$/, '');
    const org = orgInput.value.trim();
    const apiKey = keyInput.value.trim();
    if (!server || !org || !apiKey) {
      show('Server, organization, and API key are all required.', 'error');
      return;
    }

    submitBtn.disabled = true;
    show('Issuing license...', 'success');

    const headers = { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };

    try {
      const issued = await fetch(`${server}/licenses/${encodeURIComponent(org)}`, {
        method: 'POST',
        headers,
        body: JSON.stringify({ tier: tierSelect.value }),
      });
      if (!issued.ok) {
        show(explain(issued.status, await issued.text()), 'error');
        return;
      }

      const download = await fetch(`${server}/licenses/${encodeURIComponent(org)}/download`, {
        headers,
      });
      if (!download.ok) {
        show(explain(download.status, await download.text()), 'error');
        return;
      }

      downloadLicense(await download.json());
      show('License downloaded. Install it with the steps below.', 'success');
    } catch {
      show(
        `Could not reach ${server}. Check the URL, and that the server allows this origin (RTMX_ALLOWED_ORIGINS).`,
        'error',
      );
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
