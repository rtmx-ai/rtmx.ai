---
/**
 * Compatibility shim: /orgs/:slug/admin → static /orgs/admin?slug=
 * (GitHub Pages cannot serve arbitrary dynamic segments.)
 */
export function getStaticPaths() {
  return [{ params: { slug: 'acme' } }];
}

const { slug } = Astro.params;
return Astro.redirect(`/orgs/admin?slug=${encodeURIComponent(slug || '')}`);
---
