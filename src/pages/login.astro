---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Sign in', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash">
    <section class="license-header">
      <h1>Sign in to RTMX</h1>
      <p class="license-subtitle">
        Use GitHub or Google to continue to hosted Team Checkout. The managed
        sync host is <code class="server-fixed">{defaultServer}</code>.
      </p>
    </section>
    <section class="license-form-section not-content">
      <div class="oauth-actions" id="oauth-actions" hidden>
        <button type="button" class="oauth-button oauth-github" id="login-github" data-provider="github" hidden>
          <svg class="oauth-mark" data-mark="github" viewBox="0 0 98 96" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"
              d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/>
          </svg>
          <span>Continue with GitHub</span>
        </button>
        <button type="button" class="oauth-button oauth-google" id="login-google" data-provider="google" hidden>
          <svg class="oauth-mark" data-mark="google" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <span>Continue with Google</span>
        </button>
      </div>
      <div class="form-message" id="login-message" role="status" aria-live="polite"></div>
      <p class="field-help" style="margin-top: 1.5rem;">
        Self-managed operators stay on <a href="/license">/license</a>.
      </p>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }
  .license-header { text-align: center; padding: 1.5rem 2rem 0.75rem; }
  .license-header h1 {
    font-size: 2.5rem; font-weight: 700; margin: 0 0 1rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .license-subtitle { font-size: 1.1rem; color: var(--rtmx-text-muted); max-width: 640px; margin: 0 auto; line-height: 1.6; }
  .server-fixed {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95em; color: var(--rtmx-emerald-light);
  }
  .license-form-section { max-width: 420px; margin: 0 auto; padding: 2rem; text-align: center; }
  .oauth-actions { display: flex; flex-direction: column; gap: 0.75rem; }
  .oauth-button {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem;
    width: 100%; padding: 0.75rem 1.25rem; border-radius: 0.5rem;
    font-weight: 600; font-size: 1rem; font-family: inherit; cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  /* Author display must not defeat the HTML hidden attribute. */
  .oauth-button[hidden],
  .oauth-actions[hidden] {
    display: none !important;
  }
  .oauth-mark { flex-shrink: 0; }
  .oauth-github {
    background: #24292f; color: #fff; border: 1px solid #24292f;
  }
  .oauth-github:hover { background: #32383f; }
  .oauth-google {
    background: #fff; color: #1f1f1f; border: 1px solid #747775;
  }
  .oauth-google:hover { background: #f8f9fa; }
  .field-help { color: var(--rtmx-text-dim); font-size: 0.85rem; }
  .form-message { margin-top: 1rem; color: var(--rtmx-text-muted); }
  .form-message.is-error { color: #f87171; }
</style>

<script define:vars={{ defaultServer }}>
  const SESSION = 'rtmx.session';
  const params = new URLSearchParams(window.location.search);
  const next = params.get('next') || '/checkout';
  const message = document.getElementById('login-message');
  const server = defaultServer.replace(/\/+$/, '');

  function show(text, kind) {
    message.textContent = text;
    message.className = kind === 'error' ? 'form-message is-error' : 'form-message';
  }

  async function startOAuth(provider) {
    show('Redirecting to ' + provider + '...', 'ok');
    try {
      const url = new URL(server + '/auth/login/' + provider);
      url.searchParams.set('next', next);
      url.searchParams.set('redirect_uri', window.location.origin + '/auth/callback');
      const resp = await fetch(url.toString());
      if (resp.status === 503) {
        show('OAuth is not configured on the sync host yet. Private-beta buyers: use the key from sales@rtmx.ai on /checkout.', 'error');
        return;
      }
      if (!resp.ok) {
        show('Could not start sign-in (' + resp.status + ').', 'error');
        return;
      }
      const body = await resp.json();
      sessionStorage.setItem('rtmx.oauth.next', body.next || next);
      sessionStorage.setItem('rtmx.oauth.provider', provider);
      window.location.assign(body.authorization_url);
    } catch {
      show('Could not reach ' + server + '.', 'error');
    }
  }

  document.getElementById('login-github').addEventListener('click', () => startOAuth('github'));
  document.getElementById('login-google').addEventListener('click', () => startOAuth('google'));

  async function loadProviders() {
    const actions = document.getElementById('oauth-actions');
    try {
      const resp = await fetch(server + '/auth/providers');
      if (!resp.ok) {
        show('Could not load sign-in options (' + resp.status + ').', 'error');
        return;
      }
      const body = await resp.json();
      const providers = Array.isArray(body.providers) ? body.providers : [];
      let shown = 0;
      for (const id of providers) {
        const btn = document.querySelector('[data-provider="' + id + '"]');
        if (btn) {
          btn.hidden = false;
          shown += 1;
        }
      }
      if (shown === 0) {
        show('OAuth is not configured on the sync host yet. Private-beta buyers: use the key from sales@rtmx.ai on /checkout.', 'error');
        return;
      }
      actions.hidden = false;
    } catch {
      show('Could not reach ' + server + ' to load sign-in options.', 'error');
    }
  }

  // Already signed in → continue
  try {
    const existing = JSON.parse(sessionStorage.getItem(SESSION) || '');
    if (existing && existing.token) {
      window.location.replace(next);
    }
  } catch {
    /* ignore */
  }

  loadProviders();
</script>
