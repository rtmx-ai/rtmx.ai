---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Account', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash">
    <section class="license-header">
      <h1>Your account</h1>
      <p class="license-subtitle">
        Profile, organizations, connections, and billing for hosted RTMX Sync
        (<code class="server-fixed">{defaultServer}</code>).
      </p>
    </section>

    <section class="license-form-section not-content account-shell">
      <nav class="account-tabs" role="tablist" aria-label="Account sections">
        <button type="button" class="account-tab is-active" role="tab" id="tab-profile" data-tab="profile" aria-selected="true" aria-controls="panel-profile">Profile</button>
        <button type="button" class="account-tab" role="tab" id="tab-organizations" data-tab="organizations" aria-selected="false" aria-controls="panel-organizations">Organizations</button>
        <button type="button" class="account-tab" role="tab" id="tab-connections" data-tab="connections" aria-selected="false" aria-controls="panel-connections">Connections</button>
        <a class="account-tab-link" href="/billing/manage" data-testid="account-billing-link">Billing</a>
      </nav>

      <div class="account-panels">
        <div class="account-card account-tab-panel is-active" id="panel-profile" role="tabpanel" aria-labelledby="tab-profile">
          <p class="field-label">Signed in as</p>
          <p class="account-name" id="account-display-name">…</p>
          <p class="field-help" id="account-email"></p>
          <p class="field-help" id="account-identity" data-testid="account-identity"></p>
          <p class="field-help account-governance">
            RTMX accounts are keyed by email. Signing in with Google or GitHub
            that share an email lands on the same user. Linking GitHub under
            Organizations → Prove with GitHub vaults a token onto <em>this</em>
            session so affiliation can prove GitHub membership — it must not
            replace your Google session with a noreply GitHub-only account.
          </p>
          <button type="button" class="ghost-danger" id="account-signout">Sign out</button>
        </div>

        <div class="account-card account-tab-panel" id="panel-organizations" role="tabpanel" aria-labelledby="tab-organizations" hidden>
          <h2 class="account-section-title">Organizations</h2>
          <p class="field-help" data-testid="org-provenance-help">
            A Sync organization is a Sync tenant — not necessarily a GitHub (or
            other forge) org.
            <strong>Join</strong> a public Sync org with only a signed-in RTMX
            account (no forge membership proof).
            <strong>Prove with GitHub</strong> verifies GitHub organization
            membership via linked OAuth (<code>read:org</code>).
          </p>

          <section class="account-subsection" aria-labelledby="org-memberships-heading">
            <h3 class="account-subsection-title" id="org-memberships-heading">Your Sync orgs</h3>
            <p class="field-help">
              Select an active org for subsequent collaboration (multi-org accounts are first-class).
            </p>
            <ul class="org-list" id="org-list" data-testid="org-membership-list"></ul>
            <p class="field-help" id="org-empty" hidden>No organizations yet. Join a public org below, prove with GitHub, or start a 14-day Team trial on Checkout.</p>
            <a class="secondary-button-link" href="/checkout" data-testid="account-checkout-cta">Start 14-day free trial</a>
          </section>

          <section class="account-subsection" aria-labelledby="org-join-heading" data-testid="adoption-recommendations">
            <h3 class="account-subsection-title" id="org-join-heading">Join a public Sync org</h3>
            <p class="field-help">
              Projects already on Sync (dogfood: <code>rtmx-ai/rtmx</code>).
              Join does <em>not</em> require linking GitHub.
            </p>
            <ul class="org-list" id="adoption-list" data-testid="adoption-list"></ul>
            <p class="field-help" id="adoption-empty" hidden>No public adoption entries yet.</p>
            <div class="form-message" id="adoption-message" role="status" aria-live="polite"></div>
          </section>

          <section class="account-subsection" aria-labelledby="org-prove-heading" data-testid="github-affiliation">
            <h3 class="account-subsection-title" id="org-prove-heading">Prove with GitHub</h3>
            <p class="field-help">
              Optional. Link GitHub with <code>read:org</code>, then
              <strong>Affiliate</strong> to join or create a matching
              <em>public</em> Sync org. Private Sync orgs stay on the Team path.
            </p>
            <ul class="org-list" id="gh-org-list" data-testid="github-org-candidates"></ul>
            <p class="field-help" id="gh-org-empty" hidden>No GitHub organizations returned.</p>
            <p class="field-help" id="gh-org-reauth" hidden>
              GitHub is not linked on this account (or needs re-auth).
              <button type="button" class="linkish" id="link-github" data-testid="link-github">Link GitHub</button>
            </p>
            <label class="gh-create-public">
              <input type="checkbox" id="gh-create-public" checked data-testid="gh-create-public" />
              Create a public Sync org when no matching slug exists
            </label>
            <div class="form-message" id="gh-affiliate-message" role="status" aria-live="polite"></div>
          </section>
        </div>

        <div class="account-card account-tab-panel" id="panel-connections" role="tabpanel" aria-labelledby="tab-connections" hidden>
          <h2 class="account-section-title">Connections</h2>
          <p class="field-help" data-testid="connections-vault-help">
            Vaulted project-tool OAuth on Sync (Asana, Jira, Monday, GitLab, and GitHub Issues).
            Tokens can be shared into orgs without exposing secrets. This is not forge
            affiliation — use Organizations to join Sync orgs or Prove with GitHub.
            Connect from the CLI with <code>rtmx connect asana</code>,
            <code>rtmx connect jira</code>, <code>rtmx connect monday</code>,
            <code>rtmx connect gitlab</code>, or <code>rtmx connect github</code>,
            or start here when configured.
            After Connect GitHub Issues, <code>rtmx sync --service github</code>
            can use the vault when <code>GITHUB_TOKEN</code> is unset — as the
            connection owner, or as an org owner/admin after the connection is
            shared into your Sync org (secrets stay on Sync; members cannot fetch).
          </p>
          <ul class="connection-list" id="connection-list"></ul>
          <p class="field-help" id="connection-empty" hidden>No connections yet.</p>
          <div class="connections-actions">
            <button type="button" class="secondary-button" id="connect-asana" data-testid="connect-asana">Connect Asana</button>
            <button type="button" class="secondary-button" id="connect-jira" data-testid="connect-jira">Connect Jira</button>
            <button type="button" class="secondary-button" id="connect-monday" data-testid="connect-monday">Connect Monday</button>
            <button type="button" class="secondary-button" id="connect-gitlab" data-testid="connect-gitlab">Connect GitLab</button>
            <button type="button" class="secondary-button" id="connect-github" data-testid="connect-github">Connect GitHub Issues</button>
          </div>
          <div class="form-message" id="account-message" role="status" aria-live="polite"></div>
        </div>
      </div>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }
  .license-header { text-align: center; padding: 2rem 1.5rem 0.5rem; }
  .license-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.35rem); font-weight: 700; margin: 0 0 0.75rem;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .license-subtitle { font-size: 1.05rem; color: var(--rtmx-text-muted); max-width: 40rem; margin: 0 auto; line-height: 1.55; }
  .server-fixed { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: var(--rtmx-emerald-light); }
  .license-form-section.account-shell {
    max-width: min(64rem, 96vw); margin: 0 auto; padding: 1.25rem 1.25rem 3rem;
    display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); gap: 1.5rem; align-items: start;
  }
  @media (max-width: 720px) {
    .license-form-section.account-shell { grid-template-columns: 1fr; }
    .account-tabs { flex-direction: row; flex-wrap: wrap; }
  }
  .account-tabs {
    display: flex; flex-direction: column; gap: 0.25rem; position: sticky; top: 1rem;
  }
  .account-tab, .account-tab-link {
    text-align: left; padding: 0.65rem 0.85rem; border-radius: 0.5rem; border: 1px solid transparent;
    background: transparent; color: var(--rtmx-text-muted); font: inherit; font-size: 0.95rem; cursor: pointer;
    text-decoration: none;
  }
  .account-tab:hover, .account-tab-link:hover { color: var(--rtmx-text); background: var(--rtmx-bg-card); }
  .account-tab.is-active {
    color: var(--rtmx-text); background: var(--rtmx-bg-card); border-color: var(--rtmx-border);
    font-weight: 600;
  }
  .account-panels { min-width: 0; }
  .account-card {
    background: var(--rtmx-bg-card); border: 1px solid var(--rtmx-border); border-radius: 0.75rem; padding: 1.5rem 1.75rem;
  }
  .account-tab-panel[hidden] { display: none !important; }
  .account-name { margin: 0.25rem 0; font-size: 1.35rem; font-weight: 650; color: var(--rtmx-text); }
  .field-label { color: var(--rtmx-text); font-weight: 600; font-size: 0.9rem; margin: 0; }
  .field-help { color: var(--rtmx-text-dim); font-size: 0.9rem; line-height: 1.5; margin: 0.45rem 0 0; }
  .account-governance { margin-top: 1rem; max-width: 40rem; }
  .account-section-title { margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--rtmx-text); }
  .account-subsection {
    margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rtmx-border);
  }
  .account-subsection:first-of-type { margin-top: 1rem; padding-top: 0; border-top: none; }
  .account-subsection-title {
    margin: 0 0 0.35rem; font-size: 1rem; font-weight: 650; color: var(--rtmx-text);
  }
  .linkish {
    background: none; border: none; padding: 0; color: var(--rtmx-emerald-light); font: inherit;
    text-decoration: underline; cursor: pointer;
  }
  .org-list, .connection-list { list-style: none; padding: 0; margin: 0.75rem 0; }
  .org-list li, .connection-list li {
    padding: 0.7rem 0; border-bottom: 1px solid var(--rtmx-border); color: var(--rtmx-text); font-size: 0.95rem;
    display: flex; justify-content: space-between; gap: 0.75rem; align-items: center;
  }
  .connection-actions { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }
  .share-select {
    background: var(--rtmx-bg-elevated); color: var(--rtmx-text); border: 1px solid var(--rtmx-border-hover);
    border-radius: 0.35rem; padding: 0.25rem 0.4rem; font: inherit; font-size: 0.8rem; max-width: 9rem;
  }
  .org-list a, .connection-list a { color: var(--rtmx-emerald-light); font-size: 0.85rem; }
  .secondary-button, .secondary-button-link {
    margin-top: 0.75rem; padding: 0.65rem 1rem; border-radius: 0.5rem; border: 1px solid var(--rtmx-border-hover);
    background: transparent; color: var(--rtmx-text); font-weight: 600; font-family: inherit; cursor: pointer;
    display: inline-block; text-decoration: none; font-size: 0.95rem;
  }
  .ghost-danger {
    border: none; background: transparent; color: #f87171; cursor: pointer; font: inherit; text-align: left; padding: 0;
  }
  .form-message { margin-top: 0.75rem; font-size: 0.9rem; }
  .form-message.is-error { color: #fecaca; }
  .form-message.is-success { color: var(--rtmx-emerald-light); }
  .form-message:empty { display: none; }
  .gh-create-public {
    display: flex; align-items: flex-start; gap: 0.5rem; margin-top: 0.75rem;
    color: var(--rtmx-text-dim); font-size: 0.85rem; line-height: 1.4; cursor: pointer;
  }
  .gh-create-public input { margin-top: 0.15rem; }
  .org-active-badge {
    font-size: 0.75rem; color: var(--rtmx-emerald-light); border: 1px solid var(--rtmx-emerald);
    border-radius: 0.25rem; padding: 0.1rem 0.4rem; margin-left: 0.35rem;
  }
  .org-select-btn, .gh-affiliate-btn {
    border: 1px solid var(--rtmx-border-hover); background: transparent; color: var(--rtmx-emerald-light);
    border-radius: 0.35rem; padding: 0.25rem 0.55rem; font: inherit; font-size: 0.8rem; cursor: pointer;
  }
</style>

<script define:vars={{ defaultServer }}>
  const SESSION = 'rtmx.session';
  const ACTIVE_ORG = 'rtmx.active_org';
  const server = defaultServer.replace(/\/+$/, '');
  const displayEl = document.getElementById('account-display-name');
  const emailEl = document.getElementById('account-email');
  const identityEl = document.getElementById('account-identity');
  const orgListEl = document.getElementById('org-list');
  const orgEmptyEl = document.getElementById('org-empty');
  const ghListEl = document.getElementById('gh-org-list');
  const ghEmptyEl = document.getElementById('gh-org-empty');
  const ghReauthEl = document.getElementById('gh-org-reauth');
  const ghMsgEl = document.getElementById('gh-affiliate-message');
  const ghCreatePublicEl = document.getElementById('gh-create-public');
  const linkGithubBtn = document.getElementById('link-github');
  const adoptionListEl = document.getElementById('adoption-list');
  const adoptionEmptyEl = document.getElementById('adoption-empty');
  const adoptionMsgEl = document.getElementById('adoption-message');
  const listEl = document.getElementById('connection-list');
  const emptyEl = document.getElementById('connection-empty');
  const message = document.getElementById('account-message');
  /** @type {{ id: string, name?: string, slug?: string, visibility?: string }[]} */
  let cachedOrgs = [];

  function setAccountTab(tab) {
    document.querySelectorAll('.account-tab').forEach((btn) => {
      const on = btn.dataset.tab === tab;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    document.querySelectorAll('.account-tab-panel').forEach((panel) => {
      const on = panel.id === 'panel-' + tab;
      panel.hidden = !on;
      panel.classList.toggle('is-active', on);
    });
    const url = new URL(window.location.href);
    url.searchParams.set('tab', tab);
    history.replaceState({}, '', url.toString());
  }

  document.querySelectorAll('.account-tab').forEach((btn) => {
    btn.addEventListener('click', () => setAccountTab(btn.dataset.tab));
  });
  const tabAliases = { adoption: 'organizations', github: 'organizations' };
  let initialAccountTab =
    new URLSearchParams(window.location.search).get('tab') || 'profile';
  if (tabAliases[initialAccountTab]) {
    initialAccountTab = tabAliases[initialAccountTab];
  }
  if (document.getElementById('panel-' + initialAccountTab)) {
    setAccountTab(initialAccountTab);
  }

  function readSession() {
    try {
      const parsed = JSON.parse(sessionStorage.getItem(SESSION) || '');
      if (!parsed?.token) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function show(text, kind) {
    message.textContent = text;
    message.className = 'form-message is-' + kind;
  }

  function showGh(text, kind) {
    ghMsgEl.textContent = text;
    ghMsgEl.className = 'form-message is-' + kind;
  }

  function showAdoption(text, kind) {
    adoptionMsgEl.textContent = text;
    adoptionMsgEl.className = 'form-message is-' + kind;
  }

  function getActiveOrgSlug() {
    return localStorage.getItem(ACTIVE_ORG) || '';
  }

  function setActiveOrgSlug(slug) {
    if (slug) localStorage.setItem(ACTIVE_ORG, slug);
    else localStorage.removeItem(ACTIVE_ORG);
  }

  async function loadOrgs(token) {
    const resp = await fetch(server + '/orgs', {
      headers: { Authorization: 'Bearer ' + token },
    });
    if (!resp.ok) {
      orgEmptyEl.hidden = false;
      orgEmptyEl.textContent = 'Could not list organizations (' + resp.status + ').';
      return;
    }
    const body = await resp.json();
    const orgs = body.organizations || [];
    cachedOrgs = orgs;
    orgListEl.innerHTML = '';
    orgEmptyEl.hidden = orgs.length > 0;
    let active = getActiveOrgSlug();
    if (active && !orgs.some((o) => o.slug === active)) {
      active = orgs[0]?.slug || '';
      setActiveOrgSlug(active);
    } else if (!active && orgs[0]?.slug) {
      active = orgs[0].slug;
      setActiveOrgSlug(active);
    }
    for (const org of orgs) {
      const li = document.createElement('li');
      const label = document.createElement('span');
      label.textContent = (org.name || org.slug) + ' (' + (org.slug || org.id) + ')';
      if (org.visibility) {
        label.textContent += ' · ' + org.visibility;
      }
      const role = (org.role || 'member').toLowerCase();
      label.textContent += ' · ' + role;
      if (org.slug === active) {
        const badge = document.createElement('span');
        badge.className = 'org-active-badge';
        badge.textContent = 'active';
        label.appendChild(badge);
      }
      const actions = document.createElement('div');
      actions.className = 'connection-actions';
      if (org.slug && org.slug !== active) {
        const selectBtn = document.createElement('button');
        selectBtn.type = 'button';
        selectBtn.className = 'org-select-btn';
        selectBtn.textContent = 'Use';
        selectBtn.setAttribute('data-testid', 'select-org-' + org.slug);
        selectBtn.addEventListener('click', () => {
          setActiveOrgSlug(org.slug);
          loadOrgs(token);
        });
        actions.appendChild(selectBtn);
      }
      // Org admin UI requires owner/admin — public join/affiliate is member only.
      if (role === 'owner' || role === 'admin') {
        const admin = document.createElement('a');
        admin.href = '/orgs/admin?slug=' + encodeURIComponent(org.slug || org.id);
        admin.textContent = 'Admin';
        admin.setAttribute('data-testid', 'org-admin-' + (org.slug || org.id));
        actions.appendChild(admin);
      }
      li.appendChild(label);
      li.appendChild(actions);
      orgListEl.appendChild(li);
    }
  }

  async function joinPublicFromAdoption(token, orgSlug, externalRef) {
    // Public self-join only — does not prove GitHub membership (see Prove with GitHub).
    showAdoption('Joining public Sync org ' + orgSlug + '…', 'success');
    const resp = await fetch(server + '/orgs/' + encodeURIComponent(orgSlug) + '/join', {
      method: 'POST',
      headers: { Authorization: 'Bearer ' + token },
    });
    if (resp.status === 404) {
      showAdoption(
        'No public Sync org "' + orgSlug + '". Use Prove with GitHub below to Affiliate and create one.',
        'error',
      );
      return;
    }
    if (resp.status === 403) {
      showAdoption('Private Sync orgs require Team entitlement.', 'error');
      return;
    }
    if (!resp.ok) {
      showAdoption('Join failed (' + resp.status + ').', 'error');
      return;
    }
    showAdoption(externalRef + ' → joined public org ' + orgSlug + '.', 'success');
    setActiveOrgSlug(orgSlug);
    await loadOrgs(token);
    await loadAdoption(token);
  }

  async function linkGithub(token) {
    showGh('Starting GitHub link for this account…', 'success');
    try {
      const url = new URL(server + '/auth/login/github');
      url.searchParams.set('next', '/account?tab=organizations');
      url.searchParams.set('link', '1');
      url.searchParams.set('redirect_uri', window.location.origin + '/auth/callback');
      const resp = await fetch(url.toString(), {
        headers: { Authorization: 'Bearer ' + token },
      });
      if (!resp.ok) {
        showGh('Could not start GitHub link (' + resp.status + ').', 'error');
        return;
      }
      const body = await resp.json();
      sessionStorage.setItem('rtmx.oauth.next', body.next || '/account?tab=organizations');
      sessionStorage.setItem('rtmx.oauth.provider', 'github');
      window.location.assign(body.authorization_url);
    } catch {
      showGh('Could not reach ' + server + '.', 'error');
    }
  }

  async function loadAdoption(token) {
    const resp = await fetch(server + '/adoption', {
      headers: { Authorization: 'Bearer ' + token },
    });
    if (!resp.ok) {
      adoptionListEl.innerHTML = '';
      adoptionEmptyEl.hidden = false;
      adoptionEmptyEl.textContent = 'Could not load adoption registry (' + resp.status + ').';
      return;
    }
    const body = await resp.json();
    const entries = body.entries || [];
    adoptionListEl.innerHTML = '';
    adoptionEmptyEl.hidden = entries.length > 0;
    const memberSlugs = new Set(cachedOrgs.map((o) => (o.slug || '').toLowerCase()));
    for (const entry of entries) {
      const li = document.createElement('li');
      const label = document.createElement('span');
      label.textContent =
        (entry.external_ref || '') +
        ' · org ' +
        (entry.org_slug || '') +
        (entry.room ? '/' + entry.room : '');
      const actions = document.createElement('div');
      actions.className = 'connection-actions';
      const slug = entry.org_slug || '';
      if (slug && memberSlugs.has(slug.toLowerCase())) {
        const badge = document.createElement('span');
        badge.className = 'org-active-badge';
        badge.textContent = 'member';
        actions.appendChild(badge);
      } else if (slug && entry.visibility === 'public') {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'gh-affiliate-btn';
        btn.textContent = 'Join public org';
        btn.setAttribute('data-testid', 'adopt-join-' + slug);
        btn.addEventListener('click', () =>
          joinPublicFromAdoption(token, slug, entry.external_ref || ''),
        );
        actions.appendChild(btn);
      }
      li.appendChild(label);
      li.appendChild(actions);
      adoptionListEl.appendChild(li);
    }
  }

  async function affiliateGithubOrg(token, login) {
    const createPublic = !!ghCreatePublicEl.checked;
    showGh('Affiliating with ' + login + '…', 'success');
    const resp = await fetch(server + '/auth/github/orgs/affiliate', {
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + token,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ login, create_public: createPublic }),
    });
    const body = await resp.json().catch(() => ({}));
    if (resp.status === 409 && !createPublic) {
      showGh('No public Sync org for ' + login + '. Enable create-public and try again.', 'error');
      return;
    }
    if (resp.status === 403) {
      const detail = typeof body.detail === 'string' ? body.detail : JSON.stringify(body.detail || body);
      showGh(detail || 'Private Sync orgs require Team entitlement.', 'error');
      return;
    }
    if (resp.status === 401) {
      ghReauthEl.hidden = false;
      showGh('GitHub re-authorization required for organization access.', 'error');
      return;
    }
    if (!resp.ok) {
      showGh('Affiliate failed (' + resp.status + ').', 'error');
      return;
    }
    showGh('Affiliated with ' + (body.slug || login) + ' (' + (body.action || 'ok') + ').', 'success');
    if (body.slug) setActiveOrgSlug(body.slug);
    await loadOrgs(token);
    await loadGithubOrgs(token);
  }

  async function loadGithubOrgs(token) {
    ghReauthEl.hidden = true;
    ghEmptyEl.hidden = true;
    const resp = await fetch(server + '/auth/github/orgs', {
      headers: { Authorization: 'Bearer ' + token },
    });
    if (resp.status === 401) {
      ghListEl.innerHTML = '';
      ghReauthEl.hidden = false;
      return;
    }
    if (!resp.ok) {
      ghListEl.innerHTML = '';
      ghEmptyEl.hidden = false;
      ghEmptyEl.textContent = 'Could not list GitHub orgs (' + resp.status + ').';
      return;
    }
    const body = await resp.json();
    const candidates = body.orgs || [];
    ghListEl.innerHTML = '';
    ghEmptyEl.hidden = candidates.length > 0;
    const memberSlugs = new Set(cachedOrgs.map((o) => (o.slug || '').toLowerCase()));
    for (const gh of candidates) {
      const login = gh.login || '';
      if (!login) continue;
      const li = document.createElement('li');
      const label = document.createElement('span');
      label.textContent = login + (gh.description ? ' — ' + gh.description : '');
      const actions = document.createElement('div');
      actions.className = 'connection-actions';
      if (memberSlugs.has(login.toLowerCase())) {
        const joined = document.createElement('span');
        joined.className = 'org-active-badge';
        joined.textContent = 'member';
        actions.appendChild(joined);
      } else {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'gh-affiliate-btn';
        btn.textContent = 'Affiliate';
        btn.setAttribute('data-testid', 'affiliate-gh-' + login);
        btn.addEventListener('click', () => affiliateGithubOrg(token, login));
        actions.appendChild(btn);
      }
      li.appendChild(label);
      li.appendChild(actions);
      ghListEl.appendChild(li);
    }
  }

  async function shareConnection(token, connectionId, orgId) {
    const resp = await fetch(server + '/connections/' + connectionId + '/share', {
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + token,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ org_id: orgId }),
    });
    if (!resp.ok) {
      show('Could not share connection (' + resp.status + ').', 'error');
      return;
    }
    show('Connection shared into the organization.', 'success');
    await loadConnections(token);
  }

  async function loadConnections(token) {
    const resp = await fetch(server + '/connections', {
      headers: { Authorization: 'Bearer ' + token },
    });
    if (!resp.ok) {
      show('Could not load connections (' + resp.status + ').', 'error');
      return;
    }
    const body = await resp.json();
    const connections = body.connections || [];
    listEl.innerHTML = '';
    emptyEl.hidden = connections.length > 0;
    const session = readSession();
    for (const c of connections) {
      const li = document.createElement('li');
      li.className = 'connection-row';
      const span = document.createElement('span');
      const shared = (c.shared_org_ids || []).length
        ? ' · shared with ' + c.shared_org_ids.length + ' org(s)'
        : '';
      span.textContent = (c.display_label || c.provider) + ' · ' + c.status + shared;

      const actions = document.createElement('div');
      actions.className = 'connection-actions';

      if (session?.user_id && c.owner_user_id === session.user_id && cachedOrgs.length) {
        const select = document.createElement('select');
        select.setAttribute('aria-label', 'Share connection into organization');
        select.className = 'share-select';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Share to org…';
        select.appendChild(placeholder);
        for (const org of cachedOrgs) {
          if ((c.shared_org_ids || []).includes(org.id)) continue;
          const opt = document.createElement('option');
          opt.value = org.id;
          opt.textContent = org.name || org.slug || org.id;
          select.appendChild(opt);
        }
        select.addEventListener('change', async () => {
          if (!select.value) return;
          await shareConnection(token, c.id, select.value);
          select.value = '';
        });
        actions.appendChild(select);
      }

      const revoke = document.createElement('button');
      revoke.type = 'button';
      revoke.className = 'ghost-danger';
      revoke.textContent = 'Revoke';
      revoke.addEventListener('click', async () => {
        const del = await fetch(server + '/connections/' + c.id, {
          method: 'DELETE',
          headers: { Authorization: 'Bearer ' + token },
        });
        if (!del.ok) {
          show('Could not revoke (' + del.status + ').', 'error');
          return;
        }
        show('Connection revoked.', 'success');
        loadConnections(token);
      });
      actions.appendChild(revoke);
      li.appendChild(span);
      li.appendChild(actions);
      listEl.appendChild(li);
    }
  }

  async function completeConnectionIfPresent(token) {
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    const state = params.get('state');
    const err = params.get('error');
    const provider = (sessionStorage.getItem('rtmx.connection.provider') || 'asana').toLowerCase();
    if (err) {
      show(connectionProviderLabel(provider) + ' authorization was canceled or denied.', 'error');
      sessionStorage.removeItem('rtmx.connection.provider');
      return;
    }
    if (!code || !state) return;
    const label = connectionProviderLabel(provider);
    show('Completing ' + label + ' connection...', 'success');
    try {
      const resp = await fetch(server + '/connections/' + provider + '/callback', {
        method: 'POST',
        headers: {
          Authorization: 'Bearer ' + token,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ code, state }),
      });
      // Clear OAuth params from the URL without a reload.
      window.history.replaceState({}, '', '/account');
      sessionStorage.removeItem('rtmx.connection.provider');
      if (!resp.ok) {
        show('Could not complete ' + label + ' OAuth (' + resp.status + ').', 'error');
        return;
      }
      show(label + ' connected.', 'success');
      await loadConnections(token);
    } catch {
      show('Could not reach ' + server + '.', 'error');
    }
  }

  async function enrichSessionFromMe(session) {
    try {
      const resp = await fetch(server + '/auth/me', {
        headers: { Authorization: 'Bearer ' + session.token },
      });
      if (!resp.ok) return { session, me: null };
      const me = await resp.json();
      const next = {
        ...session,
        user_id: me.id || session.user_id || '',
        email: me.email || session.email || '',
        display_name: me.display_name || session.display_name || '',
        oauth_provider: me.oauth_provider || session.oauth_provider || '',
        github_linked: !!me.github_linked,
      };
      sessionStorage.setItem(SESSION, JSON.stringify(next));
      return { session: next, me };
    } catch {
      return { session, me: null };
    }
  }

  (async () => {
    let session = readSession();
    if (!session) {
      window.location.replace('/login?next=' + encodeURIComponent('/account'));
      return;
    }
    const enriched = await enrichSessionFromMe(session);
    session = enriched.session;
    displayEl.textContent = session.display_name || session.login || session.email || 'Signed in';
    emailEl.textContent = session.email || '';
    const provider = session.oauth_provider || 'unknown';
    identityEl.textContent =
      'Sign-in provider: ' +
      provider +
      (session.github_linked ? ' · GitHub linked for org affiliation' : ' · GitHub not linked');
    if (!session.github_linked) {
      ghReauthEl.hidden = false;
    }
    await completeConnectionIfPresent(session.token);
    await loadOrgs(session.token);
    await loadAdoption(session.token);
    await loadGithubOrgs(session.token);
    await loadConnections(session.token);
  })();

  document.getElementById('account-signout').addEventListener('click', () => {
    sessionStorage.removeItem(SESSION);
    window.location.assign('/');
  });

  if (linkGithubBtn) {
    linkGithubBtn.addEventListener('click', () => {
      const s = readSession();
      if (s?.token) void linkGithub(s.token);
    });
  }

  function connectionProviderLabel(provider) {
    if (provider === 'jira') return 'Jira';
    if (provider === 'monday') return 'Monday';
    if (provider === 'gitlab') return 'GitLab';
    if (provider === 'github') return 'GitHub Issues';
    return 'Asana';
  }

  function connectionProviderEnvHint(provider) {
    if (provider === 'jira') return 'RTMX_JIRA_CLIENT_ID';
    if (provider === 'monday') return 'RTMX_MONDAY_CLIENT_ID';
    if (provider === 'gitlab') return 'RTMX_GITLAB_CLIENT_ID';
    if (provider === 'github') return 'RTMX_GITHUB_ISSUES_CLIENT_ID';
    return 'RTMX_ASANA_CLIENT_ID';
  }

  async function startConnectionOAuth(provider) {
    const s = readSession();
    if (!s) return;
    const label = connectionProviderLabel(provider);
    show('Starting ' + label + ' OAuth...', 'success');
    try {
      const resp = await fetch(server + '/connections/' + provider + '/start', {
        method: 'POST',
        headers: {
          Authorization: 'Bearer ' + s.token,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          redirect_uri: window.location.origin + '/account',
        }),
      });
      if (resp.status === 503) {
        const envHint = connectionProviderEnvHint(provider);
        show(
          label + ' OAuth is not configured on the sync host yet (set ' + envHint + ').',
          'error',
        );
        return;
      }
      if (!resp.ok) {
        show('Could not start ' + label + ' OAuth (' + resp.status + ').', 'error');
        return;
      }
      const body = await resp.json();
      sessionStorage.setItem('rtmx.connection.provider', provider);
      window.location.assign(body.authorization_url);
    } catch {
      show('Could not reach ' + server + '.', 'error');
    }
  }

  document.getElementById('connect-asana').addEventListener('click', () => {
    void startConnectionOAuth('asana');
  });
  document.getElementById('connect-jira').addEventListener('click', () => {
    void startConnectionOAuth('jira');
  });
  document.getElementById('connect-monday').addEventListener('click', () => {
    void startConnectionOAuth('monday');
  });
  document.getElementById('connect-gitlab').addEventListener('click', () => {
    void startConnectionOAuth('gitlab');
  });
  document.getElementById('connect-github').addEventListener('click', () => {
    void startConnectionOAuth('github');
  });
</script>
