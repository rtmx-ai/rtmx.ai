---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Manage billing', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash">
    <section class="license-header">
      <h1>Billing</h1>
      <p class="license-subtitle">
        Current plan, invoice history, and payment settings for hosted RTMX Sync
        (<code class="server-fixed">{defaultServer}</code>). RTMX never collects a card number.
      </p>
    </section>

    <section class="license-form-section not-content billing-home" data-testid="billing-home">
      <input type="hidden" id="server-url" value={defaultServer} />

      <div id="billing-signed-out" class="billing-card" hidden data-testid="billing-signed-out">
        <p class="field-help">Sign in to view your subscription and invoices.</p>
        <a class="submit-button-link" href="/login?next=/billing/manage">Sign in</a>
      </div>

      <div id="billing-signed-in" hidden>
        <label class="field">
          <span class="field-label">Organization</span>
          <select id="org-select" class="text-input" data-testid="billing-org-select" aria-label="Organization for billing"></select>
        </label>

        <div class="billing-card" data-testid="billing-plan-card">
          <h2 class="billing-card-title">Current plan</h2>
          <dl class="billing-dl" id="plan-details">
            <div><dt>Status</dt><dd id="plan-status">…</dd></div>
            <div><dt>Source</dt><dd id="plan-source">…</dd></div>
            <div><dt>Tier</dt><dd id="plan-tier">…</dd></div>
            <div><dt>Seats</dt><dd id="plan-quantity">…</dd></div>
            <div><dt>Period ends</dt><dd id="plan-period">…</dd></div>
          </dl>
          <p class="field-help" id="plan-note"></p>
        </div>

        <div class="billing-card" data-testid="billing-history">
          <h2 class="billing-card-title">Billing history</h2>
          <ul class="invoice-list" id="invoice-list"></ul>
          <p class="field-help" id="invoice-empty" hidden>No invoices yet.</p>
        </div>

        <div class="billing-actions">
          <button type="button" class="secondary-button" id="portal-btn" data-testid="open-stripe-portal">
            Open Stripe Billing Portal
          </button>
          <p class="field-help">Update payment method, seats, or cancel (takes effect at period end).</p>
        </div>

        <div class="billing-muted-ctas" data-testid="billing-muted-ctas">
          <a
            class="muted-cta"
            id="upgrade-team-cta"
            href="/checkout?tab=team"
            data-testid="upgrade-team-cta"
          >Upgrade to Team</a>
          <a
            class="muted-cta"
            id="self-host-cta"
            href="/checkout?tab=self-hosted"
            data-testid="self-host-cta"
          >Self-managed license</a>
        </div>
      </div>

      <details class="billing-advanced" data-testid="billing-advanced">
        <summary>Advanced: open portal with admin API key</summary>
        <form id="portal-form" class="license-form" novalidate>
          <label class="field">
            <span class="field-label">Organization</span>
            <input type="text" id="org-ref" class="text-input" placeholder="acme" autocomplete="off" />
          </label>
          <label class="field">
            <span class="field-label">Admin API key</span>
            <input type="password" id="api-key" class="text-input" placeholder="rtmx_ad_..." autocomplete="off" />
          </label>
          <button type="submit" class="secondary-button" id="portal-submit">Open portal with API key</button>
        </form>
      </details>

      <div class="form-message" id="portal-message" role="status" aria-live="polite"></div>
      <p class="field-help" style="margin-top: 1rem;">
        <a href="/account">Back to account</a>
      </p>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }
  .license-header { text-align: center; padding: 1.5rem 2rem 0.75rem; }
  .license-header h1 {
    font-size: 2.5rem; font-weight: 700; margin: 0 0 1rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .license-subtitle { font-size: 1.1rem; color: var(--rtmx-text-muted); max-width: 640px; margin: 0 auto; line-height: 1.6; }
  .license-form-section.billing-home { max-width: 640px; margin: 0 auto; padding: 1.5rem 2rem 3rem; }
  .license-form { display: flex; flex-direction: column; gap: 1rem; margin-top: 0.75rem; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; margin-bottom: 1rem; }
  .field-label { color: var(--rtmx-text); font-weight: 600; font-size: 0.95rem; }
  .field-help { color: var(--rtmx-text-dim); font-size: 0.85rem; line-height: 1.45; }
  .server-fixed {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95em; color: var(--rtmx-emerald-light);
  }
  .text-input {
    padding: 0.75rem 1rem; border-radius: 0.5rem; border: 1px solid var(--rtmx-border-hover);
    background: var(--rtmx-bg-card); color: var(--rtmx-text); font-size: 1rem; font-family: inherit;
  }
  .billing-card {
    background: var(--rtmx-bg-card); border: 1px solid var(--rtmx-border); border-radius: 0.75rem;
    padding: 1.25rem 1.5rem; margin: 1rem 0;
  }
  .billing-card-title { margin: 0 0 0.75rem; font-size: 1.1rem; color: var(--rtmx-text); }
  .billing-dl { margin: 0; display: grid; gap: 0.55rem; }
  .billing-dl div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.5rem; font-size: 0.95rem; }
  .billing-dl dt { color: var(--rtmx-text-dim); margin: 0; }
  .billing-dl dd { margin: 0; color: var(--rtmx-text); }
  .invoice-list { list-style: none; padding: 0; margin: 0; }
  .invoice-list li {
    display: flex; justify-content: space-between; gap: 0.75rem; align-items: center;
    padding: 0.55rem 0; border-bottom: 1px solid var(--rtmx-border); color: var(--rtmx-text); font-size: 0.9rem;
  }
  .invoice-list a { color: var(--rtmx-emerald-light); font-size: 0.85rem; }
  .billing-actions { margin: 1.25rem 0; }
  .secondary-button, .submit-button-link {
    padding: 0.65rem 1rem; border-radius: 0.5rem; border: 1px solid var(--rtmx-border-hover);
    background: transparent; color: var(--rtmx-text); font-weight: 600; font-family: inherit;
    cursor: pointer; display: inline-block; text-decoration: none; font-size: 0.95rem;
  }
  .submit-button-link {
    border: none; background: var(--rtmx-emerald); color: var(--rtmx-bg);
  }
  .billing-muted-ctas {
    display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin: 1.5rem 0 1rem;
    padding-top: 1rem; border-top: 1px solid var(--rtmx-border);
  }
  .muted-cta {
    color: var(--rtmx-text-dim); font-size: 0.9rem; text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .muted-cta[hidden] { display: none !important; }
  .billing-advanced {
    margin-top: 1.5rem; color: var(--rtmx-text-dim); font-size: 0.9rem;
  }
  .billing-advanced summary { cursor: pointer; }
  .form-message { margin-top: 0.75rem; font-size: 0.9rem; }
  .form-message.is-error { color: #fecaca; }
  .form-message.is-success { color: var(--rtmx-emerald-light); }
  .form-message:empty { display: none; }
</style>

<script define:vars={{ defaultServer }}>
  const SESSION = 'rtmx.session';
  const server = (document.getElementById('server-url').value || defaultServer).replace(/\/+$/, '');
  const signedOut = document.getElementById('billing-signed-out');
  const signedIn = document.getElementById('billing-signed-in');
  const orgSelect = document.getElementById('org-select');
  const message = document.getElementById('portal-message');
  const upgradeCta = document.getElementById('upgrade-team-cta');
  const portalBtn = document.getElementById('portal-btn');
  /** @type {{ id: string, slug?: string, name?: string, role?: string }[]} */
  let orgs = [];

  function readSession() {
    try {
      const parsed = JSON.parse(sessionStorage.getItem(SESSION) || '');
      if (!parsed?.token) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function show(text, kind) {
    message.textContent = text;
    message.className = 'form-message is-' + kind;
  }

  function formatMoney(cents, currency) {
    const amount = (Number(cents) || 0) / 100;
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: (currency || 'usd').toUpperCase(),
      }).format(amount);
    } catch {
      return String(amount) + ' ' + (currency || 'usd');
    }
  }

  function setPlan(summary) {
    document.getElementById('plan-status').textContent = summary.status || '—';
    document.getElementById('plan-source').textContent = summary.entitlement_source || '—';
    document.getElementById('plan-tier').textContent = summary.tier || '—';
    document.getElementById('plan-quantity').textContent =
      summary.quantity != null ? String(summary.quantity) : '—';
    document.getElementById('plan-period').textContent = summary.current_period_end
      ? new Date(summary.current_period_end).toLocaleString()
      : '—';
    const note = document.getElementById('plan-note');
    if (summary.entitlement_source === 'public_org') {
      note.textContent =
        'You are on the free public-collaboration path. Private Team rooms require a paid subscription.';
    } else if (summary.cancel_at_period_end) {
      note.textContent = 'Cancellation scheduled; writes stay allowed until period end.';
    } else {
      note.textContent = '';
    }
    upgradeCta.hidden = !!summary.team_active;
    if (!summary.team_active) {
      const slug = summary.org_slug || '';
      upgradeCta.href = slug
        ? '/checkout?tab=team&org=' + encodeURIComponent(slug)
        : '/checkout?tab=team';
    }
    portalBtn.disabled = !summary.team_active;
  }

  function setInvoices(invoices) {
    const list = document.getElementById('invoice-list');
    const empty = document.getElementById('invoice-empty');
    list.innerHTML = '';
    const rows = invoices || [];
    empty.hidden = rows.length > 0;
    for (const inv of rows) {
      const li = document.createElement('li');
      const left = document.createElement('span');
      left.textContent =
        (inv.created ? new Date(inv.created).toLocaleDateString() + ' · ' : '') +
        formatMoney(inv.amount_paid, inv.currency) +
        ' · ' +
        (inv.status || '');
      li.appendChild(left);
      if (inv.hosted_invoice_url) {
        const a = document.createElement('a');
        a.href = inv.hosted_invoice_url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.textContent = 'Invoice';
        li.appendChild(a);
      }
      list.appendChild(li);
    }
  }

  async function loadSummary(token, orgRef) {
    const resp = await fetch(
      server + '/billing/summary?org_id=' + encodeURIComponent(orgRef),
      { headers: { Authorization: 'Bearer ' + token } },
    );
    if (resp.status === 403) {
      show('Owner or admin role required to view billing for this org.', 'error');
      return;
    }
    if (!resp.ok) {
      show('Could not load billing summary (' + resp.status + ').', 'error');
      return;
    }
    const summary = await resp.json();
    setPlan(summary);
    setInvoices(summary.invoices || []);
    show('', 'success');
  }

  async function loadOrgs(token) {
    const resp = await fetch(server + '/orgs', {
      headers: { Authorization: 'Bearer ' + token },
    });
    if (!resp.ok) {
      show('Could not list organizations (' + resp.status + ').', 'error');
      return;
    }
    const body = await resp.json();
    orgs = body.organizations || [];
    orgSelect.innerHTML = '';
    if (!orgs.length) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = 'No organizations yet';
      orgSelect.appendChild(opt);
      setPlan({
        status: 'none',
        entitlement_source: 'none',
        team_active: false,
        tier: null,
        quantity: null,
        current_period_end: null,
      });
      setInvoices([]);
      upgradeCta.hidden = false;
      return;
    }
    const adminOrgs = orgs.filter((o) => {
      const role = (o.role || 'owner').toLowerCase();
      return role === 'owner' || role === 'admin';
    });
    const choices = adminOrgs.length ? adminOrgs : orgs;
    for (const org of choices) {
      const opt = document.createElement('option');
      opt.value = org.id || org.slug;
      opt.textContent = (org.name || org.slug) + ' (' + (org.slug || org.id) + ')';
      orgSelect.appendChild(opt);
    }
    await loadSummary(token, orgSelect.value);
  }

  async function openPortal(token, orgRef) {
    show('Opening Billing Portal…', 'success');
    try {
      const response = await fetch(server + '/billing/portal', {
        method: 'POST',
        headers: {
          Authorization: 'Bearer ' + token,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          org_id: orgRef,
          return_url: window.location.origin + '/billing/manage',
        }),
      });
      if (!response.ok) {
        show('Portal unavailable (' + response.status + '). Complete Checkout first.', 'error');
        return;
      }
      const body = await response.json();
      window.location.assign(body.url);
    } catch {
      show('Could not reach ' + server + '.', 'error');
    }
  }

  (async () => {
    const session = readSession();
    if (!session) {
      signedOut.hidden = false;
      signedIn.hidden = true;
      return;
    }
    signedOut.hidden = true;
    signedIn.hidden = false;
    await loadOrgs(session.token);
  })();

  orgSelect.addEventListener('change', () => {
    const session = readSession();
    if (session?.token && orgSelect.value) void loadSummary(session.token, orgSelect.value);
  });

  portalBtn.addEventListener('click', () => {
    const session = readSession();
    if (!session?.token || !orgSelect.value) return;
    void openPortal(session.token, orgSelect.value);
  });

  document.getElementById('portal-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const org = document.getElementById('org-ref').value.trim();
    const apiKey = document.getElementById('api-key').value.trim();
    if (!org || !apiKey) {
      show('Organization and API key are required.', 'error');
      return;
    }
    const submitBtn = document.getElementById('portal-submit');
    submitBtn.disabled = true;
    try {
      await openPortal(apiKey, org);
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
