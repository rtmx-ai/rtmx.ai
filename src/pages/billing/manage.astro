---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Manage billing', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page">
    <section class="license-header">
      <h1>Manage your subscription</h1>
      <p class="license-subtitle">
        Seats, payment method, and cancel happen in Stripe's Billing Portal.
        Cancel takes effect at period end — writes stay allowed until then.
        RTMX never collects a card number.
      </p>
    </section>

    <section class="license-form-section not-content">
      <form id="portal-form" class="license-form" novalidate>
        <label class="field">
          <span class="field-label">RTMX Sync server</span>
          <input type="url" id="server-url" class="text-input" value={defaultServer} required />
        </label>
        <label class="field">
          <span class="field-label">Organization</span>
          <input type="text" id="org-ref" class="text-input" placeholder="acme" required />
        </label>
        <label class="field">
          <span class="field-label">Admin API key</span>
          <input type="password" id="api-key" class="text-input" placeholder="rtmx_ad_..." required autocomplete="off" />
        </label>
        <button type="submit" class="submit-button" id="portal-submit">
          Open Stripe Billing Portal
        </button>
      </form>
      <div class="form-message" id="portal-message" role="status" aria-live="polite"></div>
      <p class="field-help" style="margin-top: 1rem;">
        Need to start a subscription? <a href="/checkout">Hosted Team Checkout</a>.
      </p>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }
  .license-header { text-align: center; padding: 3rem 2rem 1rem; }
  .license-header h1 {
    font-size: 2.5rem; font-weight: 700; margin: 0 0 1rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .license-subtitle { font-size: 1.1rem; color: var(--rtmx-text-muted); max-width: 640px; margin: 0 auto; line-height: 1.6; }
  .license-form-section { max-width: 560px; margin: 0 auto; padding: 2rem; }
  .license-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  .field-label { color: var(--rtmx-text); font-weight: 600; font-size: 0.95rem; }
  .field-help { color: var(--rtmx-text-dim); font-size: 0.85rem; }
  .text-input {
    padding: 0.75rem 1rem; border-radius: 0.5rem; border: 1px solid var(--rtmx-border-hover);
    background: var(--rtmx-bg-card); color: var(--rtmx-text); font-size: 1rem; font-family: inherit;
  }
  .license-form .submit-button {
    padding: 0.875rem 2rem; border-radius: 0.5rem; border: none; background: var(--rtmx-emerald);
    color: var(--rtmx-bg); font-weight: 600; font-size: 1rem; font-family: inherit; cursor: pointer;
  }
</style>

<script>
  const form = document.getElementById('portal-form') as HTMLFormElement;
  const serverInput = document.getElementById('server-url') as HTMLInputElement;
  const orgInput = document.getElementById('org-ref') as HTMLInputElement;
  const keyInput = document.getElementById('api-key') as HTMLInputElement;
  const submitBtn = document.getElementById('portal-submit') as HTMLButtonElement;
  const message = document.getElementById('portal-message') as HTMLDivElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    const org = orgInput.value.trim();
    const apiKey = keyInput.value.trim();
    if (!server || !org || !apiKey) {
      message.textContent = 'Server, organization, and API key are required.';
      message.className = 'form-message is-error';
      return;
    }
    submitBtn.disabled = true;
    message.textContent = 'Opening Billing Portal...';
    message.className = 'form-message is-success';
    try {
      const response = await fetch(`${server}/billing/portal`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          org_id: org,
          return_url: `${window.location.origin}/billing/success`,
        }),
      });
      if (response.status === 401) {
        message.textContent = 'Sign in with an org admin credential first.';
        message.className = 'form-message is-error';
        return;
      }
      if (!response.ok) {
        message.textContent = `Portal unavailable (${response.status}). Complete Checkout first.`;
        message.className = 'form-message is-error';
        return;
      }
      const body = await response.json();
      window.location.assign(body.url);
    } catch {
      message.textContent = `Could not reach ${server}.`;
      message.className = 'form-message is-error';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
