---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Get RTMX Sync', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash" data-testid="checkout-hub">
    <section class="license-header">
      <p class="checkout-kicker">Purchase</p>
      <h1>Get RTMX Sync</h1>
      <p class="license-subtitle">
        Individual or Team on
        <code class="server-fixed">{defaultServer}</code>,
        or a self-hosted license for your node. One checkout path.
        The RTMX CLI stays free under Apache 2.0.
      </p>
    </section>

    <section class="license-form-section not-content">
      <div
        class="checkout-tabs"
        role="tablist"
        aria-label="Purchase path"
        data-testid="checkout-tabs"
      >
        <button
          type="button"
          class="checkout-tab"
          role="tab"
          id="tab-individual"
          data-testid="checkout-tab-individual"
          data-tab="individual"
          aria-selected="false"
          aria-controls="panel-individual"
        >
          Individual
        </button>
        <button
          type="button"
          class="checkout-tab is-active"
          role="tab"
          id="tab-team"
          data-testid="checkout-tab-team"
          data-tab="team"
          aria-selected="true"
          aria-controls="panel-team"
        >
          Team
        </button>
        <button
          type="button"
          class="checkout-tab"
          role="tab"
          id="tab-self-hosted"
          data-testid="checkout-tab-self-hosted"
          data-tab="self-hosted"
          aria-selected="false"
          aria-controls="panel-self-hosted"
        >
          Self-hosted
        </button>
      </div>

      <form id="checkout-form" class="license-form checkout-panel" novalidate>
        <input type="hidden" id="server-url" name="server-url" value={defaultServer} />
        <input type="hidden" id="active-tab" name="active-tab" value="team" />
        <input type="hidden" id="offering" name="offering" value="managed_sync" />

        <!-- Shared hosted org/auth (Individual + Team) -->
        <div id="hosted-shared" data-testid="checkout-hosted-shared">
          <fieldset class="checkout-step" id="org-session-panel" hidden data-testid="org-session-panel">
            <legend class="checkout-step-title">Organization</legend>

            <!-- ≥1 orgs: single select; create is an option (SITE-124) -->
            <label class="field" id="org-select-wrap" hidden data-testid="org-select-wrap">
              <span class="field-label">Your organizations</span>
              <select id="org-select" class="text-input" aria-label="Select organization" data-testid="org-select">
                <option value="">Select an organization</option>
              </select>
            </label>

            <!-- Zero orgs, or select chose "create new": name + Create -->
            <div id="org-create-wrap" class="org-create-block" hidden data-testid="org-create-wrap">
              <label class="field">
                <span class="field-label" id="org-create-label">Organization name</span>
                <input
                  type="text"
                  id="org-create-name"
                  class="text-input"
                  placeholder="Acme Engineering"
                  autocomplete="organization"
                  aria-label="New organization name"
                  data-testid="org-create-name"
                />
              </label>
              <fieldset class="visibility-fieldset" data-testid="org-visibility">
                <legend class="field-label">Visibility</legend>
                <label class="visibility-option">
                  <input
                    type="radio"
                    name="org-visibility"
                    value="private"
                    checked
                    data-testid="org-visibility-private"
                  />
                  <span>
                    <strong>Private</strong> — hosted Sync needs a Team trial or
                    subscription after the free trial.
                  </span>
                </label>
                <label class="visibility-option">
                  <input
                    type="radio"
                    name="org-visibility"
                    value="public"
                    data-testid="org-visibility-public"
                  />
                  <span>
                    <strong>Public</strong> — free for open-source collaboration on
                    managed Sync (no subscription required).
                  </span>
                </label>
              </fieldset>
              <button type="button" class="secondary-button" id="org-create" data-testid="org-create">
                Create organization
              </button>
            </div>

            <p class="field-help" id="org-help-empty" hidden data-testid="org-help-empty">
              You do not belong to an organization yet. Create one to continue.
            </p>
            <p class="field-help" id="org-help-select" hidden>
              Select an organization or create a new one.
            </p>
            <p class="field-help" id="org-admin-link" hidden>
              <a href="#" id="org-admin-anchor">Open organization admin</a>
            </p>
            <div class="key-mint-row">
              <button type="button" class="ghost-button" id="key-mint" disabled>
                Mint admin API key
              </button>
              <span class="field-help key-mint-hint">Optional · for CLI / agents</span>
            </div>
            <pre id="key-once" class="key-once" hidden></pre>
            <p class="field-help" id="key-once-help" hidden>
              Copy this <code>rtmx_ad_</code> key now — it is shown once.
              Checkout can continue with your session alone.
            </p>
          </fieldset>

          <label class="field" id="org-manual-field">
            <span class="field-label">Organization</span>
            <input
              type="text"
              id="org-ref"
              name="org-ref"
              class="text-input"
              placeholder="acme"
              required
            />
            <span class="field-help">Slug or id. Checkout refuses to start without one.</span>
          </label>

          <label class="field" id="api-key-field">
            <span class="field-label">Admin API key</span>
            <input
              type="password"
              id="api-key"
              name="api-key"
              class="text-input"
              placeholder="rtmx_ad_..."
              autocomplete="off"
            />
            <span class="field-help">
              Prefer <a href="/login?next=/checkout%3Ftab%3Dteam" id="hosted-sign-in-link">sign in</a> when OAuth is
              configured. Private beta: ops-issued
              <code>rtmx_ad_</code> key until self-serve mint is available.
              Never stored by rtmx.ai after you leave.
            </span>
          </label>
        </div>

        <div
          id="panel-individual"
          class="checkout-tab-panel"
          role="tabpanel"
          aria-labelledby="tab-individual"
          data-testid="checkout-panel-individual"
          hidden
        >
          <p class="tab-lede" data-testid="individual-lede">
            Your RTMX account is how you use Sync and collaborate with others.
            Open-source work on <strong>public</strong> projects stays free;
            private multiplayer teams use the Team tab.
          </p>
          <p class="field-help" data-testid="individual-account-note">
            Signed in as your account — not a seat pack, not a personal org purchase.
          </p>
          <p
            class="field-help"
            id="personal-org-status"
            data-testid="personal-org-status"
            hidden
          ></p>
          <div
            id="individual-public-panel"
            class="individual-public-panel"
            data-testid="individual-public-panel"
            hidden
          >
            <label class="field">
              <span class="field-label">Public organization</span>
              <select
                id="individual-public-org"
                class="text-input"
                data-testid="individual-public-org"
                aria-label="Select a public organization"
              >
                <option value="">Select a public organization</option>
              </select>
            </label>
            <p class="field-help" data-testid="individual-public-help">
              Only <strong>public</strong> orgs appear here. Private tenants use Team.
            </p>
            <label class="field">
              <span class="field-label">Or create a public org</span>
              <input
                type="text"
                id="individual-public-create-name"
                class="text-input"
                placeholder="my-oss-project"
                data-testid="individual-public-create-name"
                autocomplete="organization"
              />
            </label>
            <button
              type="button"
              class="secondary-button"
              id="individual-public-create"
              data-testid="individual-public-create"
            >
              Create public organization
            </button>
          </div>
        </div>

        <div
          id="panel-team"
          class="checkout-tab-panel is-active"
          role="tabpanel"
          aria-labelledby="tab-team"
          data-testid="checkout-panel-team"
        >
          <fieldset class="checkout-step checkout-step-plan">
            <legend class="checkout-step-title">Seats</legend>
            <div class="seats-row">
              <label class="field seats-field">
                <span class="field-label">Team seats</span>
                <input
                  type="number"
                  id="quantity"
                  name="quantity"
                  class="text-input seats-input"
                  min="1"
                  value="1"
                  required
                />
              </label>
              <p class="seats-meta">
                <span class="seats-price">$9</span>
                <span class="field-help">per user / month · 14-day free trial</span>
              </p>
            </div>
          </fieldset>
        </div>

        <div
          id="panel-self-hosted"
          class="checkout-tab-panel"
          role="tabpanel"
          aria-labelledby="tab-self-hosted"
          data-testid="checkout-panel-self-hosted"
          hidden
        >
          <p class="tab-lede">
            Issue a license file for your own rtmx-sync node. Server URL is
            editable for self-managed hosts.
          </p>
          <label class="field">
            <span class="field-label">Your rtmx-sync server</span>
            <input
              type="url"
              id="license-server-url"
              name="license-server-url"
              class="text-input"
              placeholder="https://sync.example.com"
              value={defaultServer}
            />
            <span class="field-help">The server that will enforce the license.</span>
          </label>
          <label class="field">
            <span class="field-label">Organization</span>
            <input
              type="text"
              id="license-org-ref"
              name="license-org-ref"
              class="text-input"
              placeholder="acme"
            />
          </label>
          <label class="field">
            <span class="field-label">Admin API key</span>
            <input
              type="password"
              id="license-api-key"
              name="license-api-key"
              class="text-input"
              placeholder="rtmx_ad_..."
              autocomplete="off"
            />
          </label>
          <label class="field">
            <span class="field-label">Tier</span>
            <select id="license-tier" name="license-tier" class="text-input">
              <option value="team">Team</option>
              <option value="free">Free</option>
            </select>
          </label>
        </div>

        <div class="checkout-actions">
          <div class="form-message" id="checkout-message" role="status" aria-live="polite"></div>
          <button type="submit" class="submit-button" id="checkout-submit" data-testid="checkout-cta">
            <span class="button-text" id="checkout-cta-label">Continue to Stripe Checkout</span>
          </button>
        </div>
      </form>

      <p class="checkout-alt">
        Enterprise and On-Prem stay <a href="/contact">sales-assisted</a>.
        Legacy <a href="/license">/license</a> redirects here (Self-hosted).
      </p>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }

  .license-header {
    text-align: center;
    padding: 2rem 1.5rem 0.5rem;
  }

  .checkout-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rtmx-text-dim);
  }

  .checkout-tabs {
    display: flex;
    gap: 0.35rem;
    margin: 0 0 1rem;
    padding: 0.3rem;
    background: var(--rtmx-bg-card);
    border: 1px solid var(--rtmx-border);
    border-radius: 0.75rem;
  }

  .checkout-tab {
    flex: 1;
    margin: 0;
    padding: 0.65rem 0.5rem;
    border: none;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--rtmx-text-muted);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .checkout-tab:hover {
    color: var(--rtmx-text);
  }

  .checkout-tab.is-active,
  .checkout-tab[aria-selected='true'] {
    background: color-mix(in srgb, var(--rtmx-emerald) 18%, transparent);
    color: var(--rtmx-emerald-light);
  }

  .checkout-tab-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checkout-tab-panel[hidden] {
    display: none !important;
  }

  .tab-lede {
    margin: 0;
    color: var(--rtmx-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .seats-locked-note {
    margin: 0;
  }

  .license-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .license-subtitle {
    font-size: 1.05rem;
    color: var(--rtmx-text-muted);
    max-width: 34rem;
    margin: 0 auto;
    line-height: 1.55;
  }

  .license-subtitle .server-fixed {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92em;
    color: var(--rtmx-emerald-light);
    background: var(--rtmx-bg-card);
    border: 1px solid var(--rtmx-border);
    border-radius: 0.35rem;
    padding: 0.1em 0.4em;
  }

  .license-form-section {
    max-width: 28rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
  }

  .checkout-panel {
    background: var(--rtmx-bg-card);
    border: 1px solid var(--rtmx-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--rtmx-emerald) 8%, transparent);
  }

  .license-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .checkout-step {
    margin: 0;
    padding: 0;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .checkout-step-title {
    padding: 0;
    margin: 0 0 0.15rem;
    float: none;
    width: 100%;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rtmx-text-dim);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
  }

  .field-label {
    color: var(--rtmx-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .field-help {
    color: var(--rtmx-text-dim);
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0;
  }

  .text-input {
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    border: 1px solid var(--rtmx-border-hover);
    background: var(--rtmx-bg-elevated);
    color: var(--rtmx-text);
    font-size: 1rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }

  .text-input:focus {
    outline: none;
    border-color: var(--rtmx-emerald);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rtmx-emerald) 25%, transparent);
  }

  .text-input:disabled {
    opacity: 0.55;
  }

  select.text-input {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--rtmx-text-muted) 50%),
      linear-gradient(135deg, var(--rtmx-text-muted) 50%, transparent 50%);
    background-position:
      calc(100% - 1.15rem) calc(50% - 0.15rem),
      calc(100% - 0.85rem) calc(50% - 0.15rem);
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }

  .org-create-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .visibility-fieldset {
    margin: 0;
    padding: 0.75rem 0 0;
    border: none;
  }

  .visibility-option {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    margin: 0.45rem 0 0;
    font-size: 0.88rem;
    color: var(--rtmx-text-muted);
    cursor: pointer;
  }

  .visibility-option input {
    margin-top: 0.2rem;
  }

  .visibility-option strong {
    color: var(--rtmx-text);
  }

  .individual-public-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rtmx-border);
  }

  .org-create-block .secondary-button {
    align-self: flex-start;
  }

  .secondary-button,
  .ghost-button,
  .license-form .submit-button {
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .secondary-button {
    padding: 0.7rem 1rem;
    white-space: nowrap;
    border: 1px solid var(--rtmx-border-hover);
    background: transparent;
    color: var(--rtmx-text);
  }

  .secondary-button:hover:not(:disabled) {
    border-color: var(--rtmx-emerald);
    color: var(--rtmx-emerald-light);
  }

  .ghost-button {
    padding: 0.35rem 0;
    border: none;
    background: transparent;
    color: var(--rtmx-emerald-light);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--rtmx-emerald-light) 40%, transparent);
  }

  .ghost-button:hover:not(:disabled) {
    color: var(--rtmx-emerald);
    text-decoration-color: var(--rtmx-emerald);
  }

  .ghost-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: none;
  }

  .key-mint-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding-top: 0.15rem;
  }

  .key-mint-hint {
    font-size: 0.78rem;
  }

  .key-once {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--rtmx-bg);
    border: 1px solid var(--rtmx-border-hover);
    color: var(--rtmx-emerald-light);
    font-size: 0.82rem;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .seats-row {
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
  }

  .seats-field {
    flex: 0 0 auto;
  }

  .seats-input {
    width: 5.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .seats-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0 0 0.35rem;
  }

  .seats-price {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--rtmx-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .checkout-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .license-form .submit-button {
    width: 100%;
    padding: 0.9rem 1.5rem;
    border: none;
    background: var(--rtmx-emerald);
    color: var(--rtmx-bg);
  }

  .license-form .submit-button:hover:not(:disabled) {
    background: var(--rtmx-emerald-light);
  }

  .license-form .submit-button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .form-message {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    border-radius: 0.5rem;
    padding: 0;
  }

  .form-message:empty {
    display: none;
  }

  .form-message.is-success,
  .form-message.is-error,
  .form-message.is-info {
    padding: 0.7rem 0.85rem;
  }

  .form-message.is-success {
    color: var(--rtmx-emerald-light);
    background: color-mix(in srgb, var(--rtmx-emerald) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--rtmx-emerald) 35%, transparent);
  }

  .form-message.is-info {
    color: var(--rtmx-text-muted);
    background: color-mix(in srgb, var(--rtmx-text-muted) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--rtmx-text-muted) 25%, transparent);
  }

  .form-message.is-info a {
    color: var(--rtmx-emerald-light);
  }

  .form-message.is-error {
    color: #fecaca;
    background: color-mix(in srgb, #f43f5e 14%, transparent);
    border: 1px solid color-mix(in srgb, #f43f5e 40%, transparent);
  }

  .checkout-alt {
    margin: 1.25rem 0 0;
    text-align: center;
    color: var(--rtmx-text-dim);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .checkout-alt a {
    color: var(--rtmx-emerald-light);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: color-mix(in srgb, var(--rtmx-emerald-light) 40%, transparent);
  }

  .checkout-alt a:hover {
    color: var(--rtmx-text);
    text-decoration-color: var(--rtmx-emerald-light);
  }

  /* Author .field / fieldset display would otherwise override the HTML hidden attr. */
  [hidden] { display: none !important; }
</style>

<script>
  const STORAGE = 'rtmx.checkout';
  const SESSION = 'rtmx.session';
  const CTA = {
    individual: 'Continue with your RTMX account',
    team: 'Continue to Stripe Checkout',
    'self-hosted': 'Issue and download license',
  } as const;
  type TabId = keyof typeof CTA;

  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const serverInput = document.getElementById('server-url') as HTMLInputElement;
  const activeTabInput = document.getElementById('active-tab') as HTMLInputElement;
  const hostedShared = document.getElementById('hosted-shared') as HTMLDivElement;
  const orgInput = document.getElementById('org-ref') as HTMLInputElement;
  const orgSelect = document.getElementById('org-select') as HTMLSelectElement;
  const orgSelectWrap = document.getElementById('org-select-wrap') as HTMLLabelElement;
  const orgCreateWrap = document.getElementById('org-create-wrap') as HTMLDivElement;
  const orgHelpEmpty = document.getElementById('org-help-empty') as HTMLParagraphElement;
  const orgHelpSelect = document.getElementById('org-help-select') as HTMLParagraphElement;
  const orgSessionPanel = document.getElementById('org-session-panel') as HTMLFieldSetElement;
  const orgManualField = document.getElementById('org-manual-field') as HTMLLabelElement;
  const orgCreateName = document.getElementById('org-create-name') as HTMLInputElement;
  const orgCreateBtn = document.getElementById('org-create') as HTMLButtonElement;
  const CREATE_SENTINEL = '__create__';
  const keyMintBtn = document.getElementById('key-mint') as HTMLButtonElement;
  const keyOnce = document.getElementById('key-once') as HTMLPreElement;
  const keyOnceHelp = document.getElementById('key-once-help') as HTMLParagraphElement;
  const keyInput = document.getElementById('api-key') as HTMLInputElement;
  const apiKeyField = document.getElementById('api-key-field') as HTMLLabelElement;
  const quantityInput = document.getElementById('quantity') as HTMLInputElement;
  const submitBtn = document.getElementById('checkout-submit') as HTMLButtonElement;
  const ctaLabel = document.getElementById('checkout-cta-label') as HTMLSpanElement;
  const message = document.getElementById('checkout-message') as HTMLDivElement;
  const orgAdminLink = document.getElementById('org-admin-link') as HTMLParagraphElement;
  const orgAdminAnchor = document.getElementById('org-admin-anchor') as HTMLAnchorElement;
  const licenseServer = document.getElementById('license-server-url') as HTMLInputElement;
  const licenseOrg = document.getElementById('license-org-ref') as HTMLInputElement;
  const licenseKey = document.getElementById('license-api-key') as HTMLInputElement;
  const licenseTier = document.getElementById('license-tier') as HTMLSelectElement;
  const personalOrgStatus = document.getElementById('personal-org-status') as HTMLParagraphElement;
  const individualPublicPanel = document.getElementById(
    'individual-public-panel',
  ) as HTMLDivElement;
  const individualPublicOrg = document.getElementById(
    'individual-public-org',
  ) as HTMLSelectElement;
  const individualPublicCreateName = document.getElementById(
    'individual-public-create-name',
  ) as HTMLInputElement;
  const individualPublicCreateBtn = document.getElementById(
    'individual-public-create',
  ) as HTMLButtonElement;
  let cachedOrgs: Array<{ id: string; name: string; slug: string; visibility?: string }> = [];

  function currentTab(): TabId {
    const v = activeTabInput.value;
    if (v === 'individual' || v === 'self-hosted' || v === 'team') return v;
    return 'team';
  }

  function fillIndividualPublicSelect(
    orgs: Array<{ id: string; name: string; slug: string; visibility?: string }>,
  ) {
    const publicOrgs = orgs.filter((o) => (o.visibility || 'private') === 'public');
    individualPublicOrg.innerHTML = '<option value="">Select a public organization</option>';
    for (const org of publicOrgs) {
      const opt = document.createElement('option');
      opt.value = org.slug || org.id;
      opt.textContent = `${org.name} (${org.slug || org.id})`;
      opt.dataset.visibility = 'public';
      individualPublicOrg.appendChild(opt);
    }
  }

  async function applyIndividualPath() {
    const session = readSession();
    // SITE-130: account-only — no personal-org mint, no Team org chrome.
    orgSessionPanel.hidden = true;
    orgManualField.hidden = true;
    apiKeyField.hidden = true;
    keyInput.removeAttribute('required');
    orgInput.removeAttribute('required');
    orgInput.value = '';
    quantityInput.readOnly = false;
    personalOrgStatus.hidden = false;
    if (!session?.token) {
      individualPublicPanel.hidden = true;
      personalOrgStatus.textContent =
        'Sign in with your RTMX account to continue. Private teams use the Team tab.';
      return;
    }
    const who = session.email || 'your RTMX account';
    personalOrgStatus.textContent = `Signed in as ${who}. Choose a public org below — private multiplayer is on Team.`;
    individualPublicPanel.hidden = false;
    const server = serverInput.value.trim().replace(/\/+$/, '');
    await loadOrgs(server, session.token);
    fillIndividualPublicSelect(cachedOrgs);
  }

  async function setTab(tab: TabId) {
    activeTabInput.value = tab;
    document.querySelectorAll<HTMLButtonElement>('.checkout-tab').forEach((btn) => {
      const on = btn.dataset.tab === tab;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLElement>('.checkout-tab-panel').forEach((panel) => {
      const on = panel.id === `panel-${tab}`;
      panel.hidden = !on;
      panel.classList.toggle('is-active', on);
    });
    // Team only uses shared org/auth chrome; Individual is account-oriented.
    hostedShared.hidden = tab !== 'team';
    if (tab === 'individual') {
      await applyIndividualPath();
    } else if (tab === 'team') {
      quantityInput.readOnly = false;
      personalOrgStatus.hidden = true;
      const session = readSession();
      if (session?.token) {
        await enableSessionOrgUi(
          serverInput.value.trim().replace(/\/+$/, ''),
          session.token,
        );
      } else {
        orgSessionPanel.hidden = true;
        orgManualField.hidden = false;
        apiKeyField.hidden = false;
      }
    } else {
      personalOrgStatus.hidden = true;
    }
    ctaLabel.textContent = CTA[tab];
    const url = new URL(window.location.href);
    url.searchParams.set('tab', tab);
    history.replaceState({}, '', url.toString());
    const signInLink = document.getElementById('hosted-sign-in-link') as HTMLAnchorElement | null;
    if (signInLink) {
      signInLink.href =
        '/login?next=' + encodeURIComponent('/checkout?tab=' + tab);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.checkout-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab as TabId;
      if (tab) void setTab(tab);
    });
  });

  const initialTab = (new URLSearchParams(window.location.search).get('tab') || 'team') as TabId;
  void setTab(CTA[initialTab] ? initialTab : 'team');

  // SITE-134: chrome may clear a stale token after validate; re-render honestly
  window.addEventListener('rtmx:session-cleared', () => {
    void setTab(currentTab());
  });

  function show(text: string, kind: 'success' | 'error') {
    message.textContent = text;
    message.className = `form-message is-${kind}`;
  }

  function updateOrgAdminLink(slug: string) {
    if (!slug) {
      orgAdminLink.hidden = true;
      return;
    }
    orgAdminAnchor.href = `/orgs/admin?slug=${encodeURIComponent(slug)}`;
    orgAdminLink.hidden = false;
  }

  function readSession(): { token?: string; email?: string } | null {
    try {
      return JSON.parse(sessionStorage.getItem(SESSION) || '');
    } catch {
      return null;
    }
  }

  function showOrgMode(mode: 'empty' | 'select' | 'create-from-select') {
    if (mode === 'empty') {
      orgSelectWrap.hidden = true;
      orgCreateWrap.hidden = false;
      orgHelpEmpty.hidden = false;
      orgHelpSelect.hidden = true;
      orgInput.value = '';
      keyMintBtn.disabled = true;
      updateOrgAdminLink('');
      return;
    }
    orgSelectWrap.hidden = false;
    orgHelpEmpty.hidden = true;
    orgHelpSelect.hidden = false;
    const creating = mode === 'create-from-select';
    orgCreateWrap.hidden = !creating;
    if (!creating) {
      orgCreateName.value = '';
    }
  }

  function fillOrgSelect(orgs: Array<{ id: string; name: string; slug: string }>) {
    if (orgs.length === 0) {
      showOrgMode('empty');
      return;
    }
    orgSelect.innerHTML = '<option value="">Select an organization</option>';
    for (const org of orgs) {
      const opt = document.createElement('option');
      opt.value = org.slug || org.id;
      opt.textContent = `${org.name} (${org.slug || org.id})`;
      orgSelect.appendChild(opt);
    }
    const createOpt = document.createElement('option');
    createOpt.value = CREATE_SENTINEL;
    createOpt.textContent = 'Create new organization…';
    orgSelect.appendChild(createOpt);

    showOrgMode('select');
    if (orgs.length === 1) {
      orgSelect.value = orgs[0].slug || orgs[0].id;
      orgInput.value = orgSelect.value;
      keyMintBtn.disabled = false;
      updateOrgAdminLink(orgSelect.value);
    } else {
      orgInput.value = '';
      keyMintBtn.disabled = true;
      updateOrgAdminLink('');
    }
  }

  function softSignOut(message: string) {
    // REQ-SITE-134: honest signed-out — clear local state, no red "sign out again"
    sessionStorage.removeItem(SESSION);
    sessionStorage.removeItem('rtmx.oauth.next');
    sessionStorage.removeItem('rtmx.oauth.provider');
    // Update header chrome immediately (same-tab; storage events do not fire here)
    const chromeSignIn = document.getElementById('rtmx-session-signin');
    const chromeSignedIn = document.getElementById('rtmx-session-signed-in');
    const chromeIdentity = document.getElementById('rtmx-session-identity');
    if (chromeSignIn) chromeSignIn.hidden = false;
    if (chromeSignedIn) chromeSignedIn.hidden = true;
    if (chromeIdentity) chromeIdentity.textContent = '';
    window.dispatchEvent(new CustomEvent('rtmx:session-cleared'));
    messageElSoft(message);
    orgSessionPanel.hidden = true;
    orgManualField.hidden = false;
    apiKeyField.hidden = false;
  }

  function messageElSoft(text: string) {
    message.innerHTML = '';
    message.className = 'form-message is-info';
    message.appendChild(document.createTextNode(text + ' '));
    const link = document.createElement('a');
    link.href = '/login';
    link.textContent = 'Sign in';
    message.appendChild(link);
    message.appendChild(document.createTextNode('.'));
  }

  async function loadOrgs(server: string, token: string) {
    const resp = await fetch(`${server}/orgs`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (!resp.ok) {
      if (resp.status === 401) {
        softSignOut('Your session ended.');
      } else {
        show(`Could not list organizations (${resp.status}).`, 'error');
      }
      return;
    }
    const body = await resp.json();
    cachedOrgs = body.organizations || [];
    fillOrgSelect(cachedOrgs);
  }

  async function enableSessionOrgUi(server: string, token: string) {
    orgSessionPanel.hidden = false;
    orgManualField.hidden = true;
    apiKeyField.hidden = true;
    keyInput.removeAttribute('required');
    orgInput.removeAttribute('required');
    await loadOrgs(server, token);
  }

  orgSelect.addEventListener('change', () => {
    keyOnce.hidden = true;
    keyOnceHelp.hidden = true;
    keyOnce.textContent = '';
    if (orgSelect.value === CREATE_SENTINEL) {
      showOrgMode('create-from-select');
      orgInput.value = '';
      keyMintBtn.disabled = true;
      updateOrgAdminLink('');
      orgCreateName.focus();
      return;
    }
    showOrgMode('select');
    orgInput.value = orgSelect.value;
    keyMintBtn.disabled = !orgSelect.value;
    updateOrgAdminLink(orgSelect.value);
  });

  keyMintBtn.addEventListener('click', async () => {
    const session = readSession();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    const orgRef = orgSelect.value || orgInput.value.trim();
    if (!session?.token || !orgRef) {
      show('Select an organization before minting a key.', 'error');
      return;
    }
    keyMintBtn.disabled = true;
    try {
      const resp = await fetch(`${server}/keys`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${session.token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name: `checkout-${orgRef}`,
          scope: 'admin',
          org_id: orgRef,
        }),
      });
      if (!resp.ok) {
        show(`Could not mint admin key (${resp.status}).`, 'error');
        return;
      }
      const body = await resp.json();
      keyOnce.textContent = body.key;
      keyOnce.hidden = false;
      keyOnceHelp.hidden = false;
      show('Admin API key minted. Copy it now — it will not be shown again.', 'success');
    } catch {
      show(`Could not reach ${server}.`, 'error');
    } finally {
      keyMintBtn.disabled = !orgSelect.value;
    }
  });

  function selectedVisibility(): 'public' | 'private' {
    const checked = document.querySelector(
      'input[name="org-visibility"]:checked',
    ) as HTMLInputElement | null;
    return checked?.value === 'public' ? 'public' : 'private';
  }

  orgCreateBtn.addEventListener('click', async () => {
    const session = readSession();
    const name = orgCreateName.value.trim();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (!session?.token || !name) {
      show('Sign in and enter an organization name to create one.', 'error');
      return;
    }
    orgCreateBtn.disabled = true;
    try {
      const resp = await fetch(`${server}/orgs`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${session.token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ name, visibility: selectedVisibility() }),
      });
      if (!resp.ok) {
        let detail = '';
        try {
          const errBody = (await resp.json()) as { detail?: string };
          detail = (errBody.detail || '').trim();
        } catch {
          /* ignore */
        }
        if (resp.status === 409) {
          show(
            detail ||
              `Organization “${name}” already exists. Select it from the list or choose another name.`,
            'error',
          );
          await loadOrgs(server, session.token);
          return;
        }
        show(detail || `Could not create organization (${resp.status}).`, 'error');
        return;
      }
      const org = await resp.json();
      await loadOrgs(server, session.token);
      orgSelect.value = org.slug || org.id;
      orgInput.value = orgSelect.value;
      orgCreateName.value = '';
      keyMintBtn.disabled = !orgSelect.value;
      updateOrgAdminLink(orgSelect.value);
      show(`Created organization ${org.name}.`, 'success');
    } catch {
      show(
        `Could not reach ${server}. If this persists, the name may already be taken — try another or refresh.`,
        'error',
      );
    } finally {
      orgCreateBtn.disabled = false;
    }
  });

  async function gateSignIn() {
    const session = readSession();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (session?.token) {
      if (currentTab() === 'individual') {
        await applyIndividualPath();
      } else if (currentTab() === 'team') {
        await enableSessionOrgUi(server, session.token);
      }
      return;
    }
    try {
      const probe = await fetch(`${server}/auth/login/github?next=/checkout`);
      // 503 = IdP not configured yet → keep private-beta key paste path.
      if (probe.status === 503) return;
    } catch {
      return;
    }
    const tab = currentTab();
    window.location.replace(
      '/login?next=' + encodeURIComponent('/checkout?tab=' + tab),
    );
  }

  void gateSignIn();

  function downloadLicense(envelope: unknown) {
    const blob = new Blob([JSON.stringify(envelope, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'license.json';
    anchor.click();
    URL.revokeObjectURL(url);
  }

  async function submitSelfHosted() {
    const server = licenseServer.value.trim().replace(/\/+$/, '');
    const org = licenseOrg.value.trim();
    const apiKey = licenseKey.value.trim();
    if (!server || !org || !apiKey) {
      show('Server, organization, and API key are all required.', 'error');
      return;
    }
    submitBtn.disabled = true;
    show('Issuing license...', 'success');
    const headers = { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
    try {
      const issued = await fetch(`${server}/licenses/${encodeURIComponent(org)}`, {
        method: 'POST',
        headers,
        body: JSON.stringify({ tier: licenseTier.value }),
      });
      if (!issued.ok) {
        if (issued.status === 403 || issued.status === 401) {
          show('Use an admin credential (rtmx_ad_…) for this organization.', 'error');
        } else {
          show(`License issue failed (${issued.status}).`, 'error');
        }
        return;
      }
      const download = await fetch(`${server}/licenses/${encodeURIComponent(org)}/download`, {
        headers,
      });
      if (!download.ok) {
        show(`License download failed (${download.status}).`, 'error');
        return;
      }
      downloadLicense(await download.json());
      show('License downloaded.', 'success');
    } catch {
      show(
        `Could not reach ${server}. Check the URL and RTMX_ALLOWED_ORIGINS.`,
        'error',
      );
    } finally {
      submitBtn.disabled = false;
    }
  }

  async function submitIndividualAccount() {
    const session = readSession();
    if (!session?.token) {
      show('Sign in with your RTMX account to continue.', 'error');
      window.location.assign('/login?next=' + encodeURIComponent('/checkout?tab=individual'));
      return;
    }
    const selected = individualPublicOrg.value.trim();
    if (!selected) {
      show('Select or create a public organization for free Individual Sync.', 'error');
      return;
    }
    const org = cachedOrgs.find((o) => (o.slug || o.id) === selected);
    const visibility = org?.visibility || 'private';
    if (visibility !== 'public') {
      show('Free Individual only works with public organizations. Use Team for private.', 'error');
      return;
    }
    orgInput.value = selected;
    show(
      `Affiliated with public org ${selected}. Managed Sync writes are free for public orgs — no Team Checkout.`,
      'success',
    );
  }

  individualPublicCreateBtn.addEventListener('click', async () => {
    const session = readSession();
    const name = individualPublicCreateName.value.trim();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (!session?.token || !name) {
      show('Sign in and enter a name to create a public organization.', 'error');
      return;
    }
    individualPublicCreateBtn.disabled = true;
    try {
      const resp = await fetch(`${server}/orgs`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${session.token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ name, visibility: 'public' }),
      });
      if (!resp.ok) {
        let detail = '';
        try {
          const errBody = (await resp.json()) as { detail?: string };
          detail = (errBody.detail || '').trim();
        } catch {
          /* ignore */
        }
        if (resp.status === 409) {
          show(
            detail ||
              `Organization “${name}” already exists. Select it above or choose another name.`,
            'error',
          );
          await loadOrgs(server, session.token);
          fillIndividualPublicSelect(cachedOrgs);
          return;
        }
        show(detail || `Could not create public organization (${resp.status}).`, 'error');
        return;
      }
      const org = await resp.json();
      await loadOrgs(server, session.token);
      fillIndividualPublicSelect(cachedOrgs);
      individualPublicOrg.value = org.slug || org.id;
      individualPublicCreateName.value = '';
      show(`Created public organization ${org.name}.`, 'success');
    } catch {
      show(
        `Could not reach ${server}. If this persists, the name may already be taken — try another or refresh and select it.`,
        'error',
      );
    } finally {
      individualPublicCreateBtn.disabled = false;
    }
  });

  async function submitHostedStripe() {
    if (currentTab() === 'individual') {
      await submitIndividualAccount();
      return;
    }
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (orgSelect.value) orgInput.value = orgSelect.value;
    const org = orgInput.value.trim();
    const apiKey = keyInput.value.trim();
    const session = readSession();
    const bearer = apiKey || session?.token || '';
    const quantity = Number(quantityInput.value);
    if (!org || !bearer || !Number.isInteger(quantity) || quantity < 1) {
      show('Organization, sign-in or API key, and seat count are required.', 'error');
      return;
    }

    submitBtn.disabled = true;
    show('Creating Checkout Session...', 'success');

    try {
      const origin = window.location.origin;
      const response = await fetch(`${server}/billing/checkout`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${bearer}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          offering: 'managed_sync',
          tier: 'team',
          quantity,
          org_id: org,
          success_url: `${origin}/billing/success?session_id={CHECKOUT_SESSION_ID}`,
          cancel_url: `${origin}/billing/cancel`,
        }),
      });
      if (response.status === 401 || response.status === 400) {
        if (response.status === 401 && session?.token && !apiKey) {
          softSignOut('Your session ended.');
        } else {
          show('Sign in or create an organization first.', 'error');
        }
        return;
      }
      if (!response.ok) {
        show(`Checkout could not start (${response.status}).`, 'error');
        return;
      }
      const body = await response.json();
      sessionStorage.setItem(STORAGE, JSON.stringify({ server, org, apiKey: bearer }));
      window.location.assign(body.url);
    } catch {
      show(
        `Could not reach ${server}. Check the URL and RTMX_ALLOWED_ORIGINS.`,
        'error',
      );
    } finally {
      submitBtn.disabled = false;
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (currentTab() === 'self-hosted') {
      await submitSelfHosted();
      return;
    }
    await submitHostedStripe();
  });
</script>
