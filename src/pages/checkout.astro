---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Hosted Team Checkout', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash">
    <section class="license-header">
      <p class="checkout-kicker">Hosted Team · $9/user/month</p>
      <h1>Start hosted RTMX Sync</h1>
      <p class="license-subtitle">
        A tenant-isolated room on
        <code class="server-fixed">{defaultServer}</code>.
        Card details stay on Stripe. The RTMX CLI stays free under Apache 2.0.
      </p>
    </section>

    <section class="license-form-section not-content">
      <form id="checkout-form" class="license-form checkout-panel" novalidate>
        <input type="hidden" id="server-url" name="server-url" value={defaultServer} />

        <fieldset class="checkout-step" id="org-session-panel" hidden>
          <legend class="checkout-step-title">Organization</legend>
          <label class="field">
            <span class="field-label">Your organizations</span>
            <select id="org-select" class="text-input" aria-label="Select organization">
              <option value="">Select an organization</option>
            </select>
          </label>
          <div class="org-create-row">
            <input
              type="text"
              id="org-create-name"
              class="text-input"
              placeholder="New org name"
              autocomplete="organization"
              aria-label="New organization name"
            />
            <button type="button" class="secondary-button" id="org-create">
              Create
            </button>
          </div>
          <p class="field-help">Create or select an org — no ops bootstrap.</p>
          <p class="field-help" id="org-admin-link" hidden>
            <a href="#" id="org-admin-anchor">Open organization admin</a>
          </p>
          <div class="key-mint-row">
            <button type="button" class="ghost-button" id="key-mint" disabled>
              Mint admin API key
            </button>
            <span class="field-help key-mint-hint">Optional · for CLI / agents</span>
          </div>
          <pre id="key-once" class="key-once" hidden></pre>
          <p class="field-help" id="key-once-help" hidden>
            Copy this <code>rtmx_ad_</code> key now — it is shown once.
            Checkout can continue with your session alone.
          </p>
        </fieldset>

        <label class="field" id="org-manual-field">
          <span class="field-label">Organization</span>
          <input
            type="text"
            id="org-ref"
            name="org-ref"
            class="text-input"
            placeholder="acme"
            required
          />
          <span class="field-help">Slug or id. Checkout refuses to start without one.</span>
        </label>

        <label class="field" id="api-key-field">
          <span class="field-label">Admin API key</span>
          <input
            type="password"
            id="api-key"
            name="api-key"
            class="text-input"
            placeholder="rtmx_ad_..."
            autocomplete="off"
          />
          <span class="field-help">
            Prefer <a href="/login?next=/checkout">sign in</a> when OAuth is
            configured. Private beta: ops-issued
            <code>rtmx_ad_</code> key until self-serve mint is available.
            Never stored by rtmx.ai after you leave.
          </span>
        </label>

        <fieldset class="checkout-step checkout-step-plan">
          <legend class="checkout-step-title">Seats</legend>
          <div class="seats-row">
            <label class="field seats-field">
              <span class="field-label">Team seats</span>
              <input
                type="number"
                id="quantity"
                name="quantity"
                class="text-input seats-input"
                min="1"
                value="1"
                required
              />
            </label>
            <p class="seats-meta">
              <span class="seats-price">$9</span>
              <span class="field-help">per user / month</span>
            </p>
          </div>
        </fieldset>

        <input type="hidden" id="offering" name="offering" value="managed_sync" />

        <div class="checkout-actions">
          <div class="form-message" id="checkout-message" role="status" aria-live="polite"></div>
          <button type="submit" class="submit-button" id="checkout-submit">
            <span class="button-text">Continue to Stripe Checkout</span>
          </button>
        </div>
      </form>

      <p class="checkout-alt">
        Operating your own node instead?
        <a href="/license">Download a self-managed license</a>.
        <br />
        Enterprise and On-Prem stay <a href="/contact">sales-assisted</a>.
      </p>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }

  .license-header {
    text-align: center;
    padding: 2rem 1.5rem 0.5rem;
  }

  .checkout-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rtmx-text-dim);
  }

  .license-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .license-subtitle {
    font-size: 1.05rem;
    color: var(--rtmx-text-muted);
    max-width: 34rem;
    margin: 0 auto;
    line-height: 1.55;
  }

  .license-subtitle .server-fixed {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92em;
    color: var(--rtmx-emerald-light);
    background: var(--rtmx-bg-card);
    border: 1px solid var(--rtmx-border);
    border-radius: 0.35rem;
    padding: 0.1em 0.4em;
  }

  .license-form-section {
    max-width: 28rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
  }

  .checkout-panel {
    background: var(--rtmx-bg-card);
    border: 1px solid var(--rtmx-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--rtmx-emerald) 8%, transparent);
  }

  .license-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .checkout-step {
    margin: 0;
    padding: 0;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .checkout-step-title {
    padding: 0;
    margin: 0 0 0.15rem;
    float: none;
    width: 100%;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rtmx-text-dim);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
  }

  .field-label {
    color: var(--rtmx-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .field-help {
    color: var(--rtmx-text-dim);
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0;
  }

  .text-input {
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    border: 1px solid var(--rtmx-border-hover);
    background: var(--rtmx-bg-elevated);
    color: var(--rtmx-text);
    font-size: 1rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }

  .text-input:focus {
    outline: none;
    border-color: var(--rtmx-emerald);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rtmx-emerald) 25%, transparent);
  }

  .text-input:disabled {
    opacity: 0.55;
  }

  select.text-input {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--rtmx-text-muted) 50%),
      linear-gradient(135deg, var(--rtmx-text-muted) 50%, transparent 50%);
    background-position:
      calc(100% - 1.15rem) calc(50% - 0.15rem),
      calc(100% - 0.85rem) calc(50% - 0.15rem);
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }

  .org-create-row {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .org-create-row .text-input {
    flex: 1;
    min-width: 0;
  }

  .secondary-button,
  .ghost-button,
  .license-form .submit-button {
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .secondary-button {
    padding: 0.7rem 1rem;
    white-space: nowrap;
    border: 1px solid var(--rtmx-border-hover);
    background: transparent;
    color: var(--rtmx-text);
  }

  .secondary-button:hover:not(:disabled) {
    border-color: var(--rtmx-emerald);
    color: var(--rtmx-emerald-light);
  }

  .ghost-button {
    padding: 0.35rem 0;
    border: none;
    background: transparent;
    color: var(--rtmx-emerald-light);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--rtmx-emerald-light) 40%, transparent);
  }

  .ghost-button:hover:not(:disabled) {
    color: var(--rtmx-emerald);
    text-decoration-color: var(--rtmx-emerald);
  }

  .ghost-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: none;
  }

  .key-mint-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding-top: 0.15rem;
  }

  .key-mint-hint {
    font-size: 0.78rem;
  }

  .key-once {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--rtmx-bg);
    border: 1px solid var(--rtmx-border-hover);
    color: var(--rtmx-emerald-light);
    font-size: 0.82rem;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .seats-row {
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
  }

  .seats-field {
    flex: 0 0 auto;
  }

  .seats-input {
    width: 5.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .seats-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0 0 0.35rem;
  }

  .seats-price {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--rtmx-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .checkout-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .license-form .submit-button {
    width: 100%;
    padding: 0.9rem 1.5rem;
    border: none;
    background: var(--rtmx-emerald);
    color: var(--rtmx-bg);
  }

  .license-form .submit-button:hover:not(:disabled) {
    background: var(--rtmx-emerald-light);
  }

  .license-form .submit-button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .form-message {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    border-radius: 0.5rem;
    padding: 0;
  }

  .form-message:empty {
    display: none;
  }

  .form-message.is-success,
  .form-message.is-error {
    padding: 0.7rem 0.85rem;
  }

  .form-message.is-success {
    color: var(--rtmx-emerald-light);
    background: color-mix(in srgb, var(--rtmx-emerald) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--rtmx-emerald) 35%, transparent);
  }

  .form-message.is-error {
    color: #fecaca;
    background: color-mix(in srgb, #f43f5e 14%, transparent);
    border: 1px solid color-mix(in srgb, #f43f5e 40%, transparent);
  }

  .checkout-alt {
    margin: 1.25rem 0 0;
    text-align: center;
    color: var(--rtmx-text-dim);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .checkout-alt a {
    color: var(--rtmx-emerald-light);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: color-mix(in srgb, var(--rtmx-emerald-light) 40%, transparent);
  }

  .checkout-alt a:hover {
    color: var(--rtmx-text);
    text-decoration-color: var(--rtmx-emerald-light);
  }

  /* Author .field / fieldset display would otherwise override the HTML hidden attr. */
  [hidden] { display: none !important; }
</style>

<script>
  const STORAGE = 'rtmx.checkout';
  const SESSION = 'rtmx.session';
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const serverInput = document.getElementById('server-url') as HTMLInputElement;
  const orgInput = document.getElementById('org-ref') as HTMLInputElement;
  const orgSelect = document.getElementById('org-select') as HTMLSelectElement;
  const orgSessionPanel = document.getElementById('org-session-panel') as HTMLFieldSetElement;
  const orgManualField = document.getElementById('org-manual-field') as HTMLLabelElement;
  const orgCreateName = document.getElementById('org-create-name') as HTMLInputElement;
  const orgCreateBtn = document.getElementById('org-create') as HTMLButtonElement;
  const keyMintBtn = document.getElementById('key-mint') as HTMLButtonElement;
  const keyOnce = document.getElementById('key-once') as HTMLPreElement;
  const keyOnceHelp = document.getElementById('key-once-help') as HTMLParagraphElement;
  const keyInput = document.getElementById('api-key') as HTMLInputElement;
  const apiKeyField = document.getElementById('api-key-field') as HTMLLabelElement;
  const quantityInput = document.getElementById('quantity') as HTMLInputElement;
  const submitBtn = document.getElementById('checkout-submit') as HTMLButtonElement;
  const message = document.getElementById('checkout-message') as HTMLDivElement;
  const orgAdminLink = document.getElementById('org-admin-link') as HTMLParagraphElement;
  const orgAdminAnchor = document.getElementById('org-admin-anchor') as HTMLAnchorElement;

  function show(text: string, kind: 'success' | 'error') {
    message.textContent = text;
    message.className = `form-message is-${kind}`;
  }

  function updateOrgAdminLink(slug: string) {
    if (!slug) {
      orgAdminLink.hidden = true;
      return;
    }
    orgAdminAnchor.href = `/orgs/${encodeURIComponent(slug)}/admin`;
    orgAdminLink.hidden = false;
  }

  function readSession(): { token?: string; email?: string } | null {
    try {
      return JSON.parse(sessionStorage.getItem(SESSION) || '');
    } catch {
      return null;
    }
  }

  function fillOrgSelect(orgs: Array<{ id: string; name: string; slug: string }>) {
    orgSelect.innerHTML = '<option value="">Select an organization</option>';
    for (const org of orgs) {
      const opt = document.createElement('option');
      opt.value = org.slug || org.id;
      opt.textContent = `${org.name} (${org.slug || org.id})`;
      orgSelect.appendChild(opt);
    }
    if (orgs.length === 1) {
      orgSelect.value = orgs[0].slug || orgs[0].id;
      orgInput.value = orgSelect.value;
      keyMintBtn.disabled = false;
      updateOrgAdminLink(orgSelect.value);
    } else {
      updateOrgAdminLink(orgSelect.value);
    }
  }

  async function loadOrgs(server: string, token: string) {
    const resp = await fetch(`${server}/orgs`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (!resp.ok) {
      if (resp.status === 401) {
        show('Session expired or invalid. Sign out and sign in again.', 'error');
      } else {
        show(`Could not list organizations (${resp.status}).`, 'error');
      }
      return;
    }
    const body = await resp.json();
    fillOrgSelect(body.organizations || []);
  }

  async function enableSessionOrgUi(server: string, token: string) {
    orgSessionPanel.hidden = false;
    orgManualField.hidden = true;
    apiKeyField.hidden = true;
    keyInput.removeAttribute('required');
    orgInput.removeAttribute('required');
    await loadOrgs(server, token);
  }

  orgSelect.addEventListener('change', () => {
    orgInput.value = orgSelect.value;
    keyMintBtn.disabled = !orgSelect.value;
    updateOrgAdminLink(orgSelect.value);
    keyOnce.hidden = true;
    keyOnceHelp.hidden = true;
    keyOnce.textContent = '';
  });

  keyMintBtn.addEventListener('click', async () => {
    const session = readSession();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    const orgRef = orgSelect.value || orgInput.value.trim();
    if (!session?.token || !orgRef) {
      show('Select an organization before minting a key.', 'error');
      return;
    }
    keyMintBtn.disabled = true;
    try {
      const resp = await fetch(`${server}/keys`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${session.token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name: `checkout-${orgRef}`,
          scope: 'admin',
          org_id: orgRef,
        }),
      });
      if (!resp.ok) {
        show(`Could not mint admin key (${resp.status}).`, 'error');
        return;
      }
      const body = await resp.json();
      keyOnce.textContent = body.key;
      keyOnce.hidden = false;
      keyOnceHelp.hidden = false;
      show('Admin API key minted. Copy it now — it will not be shown again.', 'success');
    } catch {
      show(`Could not reach ${server}.`, 'error');
    } finally {
      keyMintBtn.disabled = !orgSelect.value;
    }
  });

  orgCreateBtn.addEventListener('click', async () => {
    const session = readSession();
    const name = orgCreateName.value.trim();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (!session?.token || !name) {
      show('Sign in and enter an organization name to create one.', 'error');
      return;
    }
    orgCreateBtn.disabled = true;
    try {
      const resp = await fetch(`${server}/orgs`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${session.token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ name }),
      });
      if (!resp.ok) {
        show(`Could not create organization (${resp.status}).`, 'error');
        return;
      }
      const org = await resp.json();
      await loadOrgs(server, session.token);
      orgSelect.value = org.slug || org.id;
      orgInput.value = orgSelect.value;
      orgCreateName.value = '';
      keyMintBtn.disabled = !orgSelect.value;
      updateOrgAdminLink(orgSelect.value);
      show(`Created organization ${org.name}.`, 'success');
    } catch {
      show(`Could not reach ${server}.`, 'error');
    } finally {
      orgCreateBtn.disabled = false;
    }
  });

  async function gateSignIn() {
    const session = readSession();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (session?.token) {
      await enableSessionOrgUi(server, session.token);
      return;
    }
    try {
      const probe = await fetch(`${server}/auth/login/github?next=/checkout`);
      // 503 = IdP not configured yet → keep private-beta key paste path.
      if (probe.status === 503) return;
    } catch {
      return;
    }
    window.location.replace('/login?next=' + encodeURIComponent('/checkout'));
  }

  gateSignIn();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const server = serverInput.value.trim().replace(/\/+$/, '');
    if (orgSelect.value) orgInput.value = orgSelect.value;
    const org = orgInput.value.trim();
    const apiKey = keyInput.value.trim();
    const session = readSession();
    const bearer = apiKey || session?.token || '';
    const quantity = Number(quantityInput.value);
    if (!org || !bearer || !Number.isInteger(quantity) || quantity < 1) {
      show('Organization, sign-in or API key, and seat count are required.', 'error');
      return;
    }

    submitBtn.disabled = true;
    show('Creating Checkout Session...', 'success');

    try {
      const origin = window.location.origin;
      const response = await fetch(`${server}/billing/checkout`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${bearer}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          offering: 'managed_sync',
          tier: 'team',
          quantity,
          org_id: org,
          success_url: `${origin}/billing/success?session_id={CHECKOUT_SESSION_ID}`,
          cancel_url: `${origin}/billing/cancel`,
        }),
      });
      if (response.status === 401 || response.status === 400) {
        show('Sign in or create an organization first.', 'error');
        return;
      }
      if (!response.ok) {
        show(`Checkout could not start (${response.status}).`, 'error');
        return;
      }
      const body = await response.json();
      sessionStorage.setItem(STORAGE, JSON.stringify({ server, org, apiKey: bearer }));
      window.location.assign(body.url);
    } catch {
      show(
        `Could not reach ${server}. Check the URL and RTMX_ALLOWED_ORIGINS.`,
        'error',
      );
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
