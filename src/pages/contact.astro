---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const salesFormId =
  import.meta.env.PUBLIC_RTMX_SALES_FORM_ID || '7f0d3d5f-7dbb-4d17-88a4-3913256730b7';
---

<StarlightPage frontmatter={{ title: 'Contact sales', template: 'splash', hero: { tagline: '' } }}>
  <div class="contact-page rtmx-splash">
    <section class="contact-header">
      <h1>Talk with RTMX sales</h1>
      <p class="contact-subtitle">
        Enterprise SSO, residency, SLA, and On-Prem / air-gapped deployments are
        sales-assisted. Tell us what you need — we will follow up. Team Sync stays
        self-serve on <a href="/checkout">Checkout</a>.
      </p>
    </section>

    <section class="contact-form-section not-content">
      <form id="sales-form" class="contact-form" novalidate data-form-id={salesFormId}>
        <label class="field">
          <span class="field-label">Work email</span>
          <input
            type="email"
            id="sales-email"
            name="email"
            class="text-input"
            placeholder="you@company.com"
            required
            autocomplete="email"
            aria-describedby="sales-email-error"
          />
          <p class="field-error" id="sales-email-error" role="alert" aria-live="polite"></p>
        </label>

        <label class="field">
          <span class="field-label">Name</span>
          <input type="text" id="sales-name" name="name" class="text-input" autocomplete="name" />
        </label>

        <label class="field">
          <span class="field-label">Company</span>
          <input
            type="text"
            id="sales-company"
            name="company"
            class="text-input"
            autocomplete="organization"
          />
        </label>

        <label class="field">
          <span class="field-label">Interest</span>
          <select id="sales-intent" name="intent" class="text-input" aria-label="Interest">
            <option value="general">General / volume licensing</option>
            <option value="enterprise">Enterprise (SSO, residency, SLA)</option>
            <option value="on-prem">On-Prem / air-gapped</option>
          </select>
        </label>

        <label class="field">
          <span class="field-label">How can we help?</span>
          <textarea
            id="sales-message"
            name="message"
            class="text-input textarea"
            rows="5"
            placeholder="Deployment model, compliance needs, timeline…"
          ></textarea>
        </label>

        <button type="submit" class="submit-button" id="sales-submit">
          <span class="button-text">Send message</span>
          <span class="button-spinner" aria-hidden="true"></span>
        </button>
      </form>
      <div class="form-message" id="sales-message-status" role="status" aria-live="polite"></div>
      <p class="privacy-note">
        We use this only to respond about RTMX commercial options. Prefer self-serve Team?
        <a href="/pricing">See pricing</a>.
      </p>
    </section>
  </div>
</StarlightPage>

<script is:inline src="https://www.google.com/recaptcha/api.js?render=6Lf3wo0sAAAAAP0s-L9egQRxzjZOqpjh9N9nulVM"></script>
<script>
  declare const grecaptcha: {
    ready: (cb: () => void) => void;
    execute: (siteKey: string, options: { action: string }) => Promise<string>;
  };

  const form = document.getElementById('sales-form') as HTMLFormElement;
  const emailInput = document.getElementById('sales-email') as HTMLInputElement;
  const emailError = document.getElementById('sales-email-error') as HTMLParagraphElement;
  const nameInput = document.getElementById('sales-name') as HTMLInputElement;
  const companyInput = document.getElementById('sales-company') as HTMLInputElement;
  const intentSelect = document.getElementById('sales-intent') as HTMLSelectElement;
  const messageInput = document.getElementById('sales-message') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('sales-submit') as HTMLButtonElement;
  const buttonText = submitBtn.querySelector('.button-text') as HTMLSpanElement;
  const formMessage = document.getElementById('sales-message-status') as HTMLDivElement;

  const params = new URLSearchParams(window.location.search);
  const intentParam = params.get('intent');
  if (intentParam && ['enterprise', 'on-prem', 'general'].includes(intentParam)) {
    intentSelect.value = intentParam;
  }

  function validateEmail(): boolean {
    const value = emailInput.value.trim();
    if (!value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
      emailError.textContent = 'Enter a valid work email.';
      emailInput.setAttribute('aria-invalid', 'true');
      return false;
    }
    emailError.textContent = '';
    emailInput.removeAttribute('aria-invalid');
    return true;
  }

  emailInput.addEventListener('input', () => {
    if (emailInput.getAttribute('aria-invalid') === 'true') validateEmail();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validateEmail()) {
      emailInput.focus();
      return;
    }
    const formId = form.dataset.formId || '';
    if (!formId) {
      formMessage.textContent =
        'Sales form is not configured yet. Please try again later.';
      formMessage.className = 'form-message is-error';
      return;
    }

    submitBtn.classList.add('is-loading');
    submitBtn.disabled = true;
    buttonText.textContent = 'Sending...';
    formMessage.textContent = '';
    formMessage.className = 'form-message';

    try {
      const token = await new Promise<string>((resolve, reject) => {
        if (typeof grecaptcha === 'undefined') {
          reject(new Error('reCAPTCHA not loaded'));
          return;
        }
        grecaptcha.ready(() => {
          grecaptcha
            .execute('6Lf3wo0sAAAAAP0s-L9egQRxzjZOqpjh9N9nulVM', { action: 'sales_contact' })
            .then(resolve)
            .catch(reject);
        });
      });

      const response = await fetch('https://forms.rtmx.ai/api/form-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formId,
          email: emailInput.value.trim(),
          name: nameInput.value.trim(),
          company: companyInput.value.trim(),
          intent: intentSelect.value,
          message: messageInput.value.trim(),
          recaptchaToken: token,
        }),
      });

      if (!response.ok) throw new Error('Submission failed');

      form.style.display = 'none';
      formMessage.textContent = 'Thanks — we will follow up shortly.';
      formMessage.className = 'form-message is-success';
    } catch {
      formMessage.textContent = 'Something went wrong. Please try again in a moment.';
      formMessage.className = 'form-message is-error';
    } finally {
      submitBtn.classList.remove('is-loading');
      submitBtn.disabled = false;
      buttonText.textContent = 'Send message';
    }
  });
</script>

<style is:global>
  .contact-page {
    background: var(--rtmx-bg);
    min-height: 100vh;
    width: 100%;
  }
  .contact-header {
    text-align: center;
    padding: 1.5rem 2rem 0.75rem;
  }
  .contact-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .contact-subtitle {
    font-size: 1.1rem;
    color: var(--rtmx-text-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .contact-form-section {
    max-width: 560px;
    margin: 0 auto;
    padding: 2rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .contact-form .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .contact-form .field-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--rtmx-text);
  }
  .contact-form .text-input {
    background: var(--rtmx-bg-elevated);
    border: 1px solid var(--rtmx-border);
    color: var(--rtmx-text);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
  }
  .contact-form .text-input.textarea {
    resize: vertical;
    min-height: 7rem;
    font-family: inherit;
  }
  .contact-form .field-error {
    margin: 0;
    min-height: 1.1rem;
    font-size: 0.85rem;
    color: #f87171;
  }
  .contact-form .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--rtmx-emerald);
    color: var(--rtmx-bg);
    border: none;
    border-radius: 0.5rem;
    padding: 0.9rem 1.25rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .contact-form .submit-button.is-loading .button-spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid rgba(0, 0, 0, 0.25);
    border-top-color: var(--rtmx-bg);
    border-radius: 50%;
    animation: sales-spin 0.7s linear infinite;
  }
  @keyframes sales-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .contact-form-section .form-message {
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .contact-form-section .form-message.is-success {
    color: var(--rtmx-emerald-light);
  }
  .contact-form-section .form-message.is-error {
    color: #f87171;
  }
  .contact-form-section .privacy-note {
    margin-top: 1.25rem;
    color: var(--rtmx-text-dim);
    font-size: 0.9rem;
  }
</style>
