---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const defaultServer = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<StarlightPage frontmatter={{ title: 'Dashboard', template: 'splash', hero: { tagline: '' } }}>
  <div class="license-page rtmx-splash" data-testid="dashboard-shell">
    <section class="license-header">
      <h1>Dashboard</h1>
      <p class="license-subtitle" data-testid="dashboard-subtitle">
        Org-scoped Sync rooms on
        <code class="server-fixed">{defaultServer}</code>
        — live presence for your team and agents.
      </p>
    </section>

    <section class="license-form-section not-content dashboard-panel">
      <div class="account-card" id="dashboard-identity">
        <p class="field-label">Signed in as</p>
        <p class="account-name" id="dashboard-display-name" data-testid="dashboard-identity">…</p>
        <p class="field-help" id="dashboard-email"></p>
      </div>

      <div class="account-card" id="dashboard-orgs">
        <h2 class="account-section-title">Organizations</h2>
        <ul class="org-list" id="dashboard-org-list" data-testid="dashboard-org-list"></ul>
        <p class="field-help" id="dashboard-org-empty" hidden>
          No organizations yet. Create one on Checkout.
        </p>
      </div>

      <div class="account-card" id="dashboard-rooms-card">
        <div class="rooms-header">
          <h2 class="account-section-title">Rooms</h2>
          <p
            class="sync-status"
            id="dashboard-sync-status"
            data-testid="dashboard-sync-status"
            data-state="idle"
            aria-live="polite"
          >
            Idle
          </p>
        </div>
        <p class="field-help" id="dashboard-selected-org" data-testid="dashboard-selected-org"></p>
        <ul class="org-list" id="dashboard-room-list" data-testid="dashboard-room-list"></ul>
        <p class="field-help" id="dashboard-room-empty" data-testid="dashboard-room-empty" hidden>
          No rooms in this org yet.
        </p>
      </div>

      <div class="account-card" id="dashboard-overview-card" data-testid="dashboard-overview">
        <h2 class="account-section-title">Status overview</h2>
        <p class="field-help overview-summary" id="dashboard-overview-summary" data-testid="dashboard-overview-summary">
          Loading…
        </p>
        <div class="overview-stats" id="dashboard-overview-stats" data-testid="dashboard-overview-stats" hidden>
          <div class="stat"><span class="stat-value" id="ov-complete">0</span><span class="stat-label">Complete</span></div>
          <div class="stat"><span class="stat-value" id="ov-partial">0</span><span class="stat-label">Partial</span></div>
          <div class="stat"><span class="stat-value" id="ov-missing">0</span><span class="stat-label">Missing</span></div>
          <div class="stat"><span class="stat-value" id="ov-pct">0%</span><span class="stat-label">Done</span></div>
        </div>
        <ul class="phase-list" id="dashboard-phase-list" data-testid="dashboard-phase-list"></ul>
      </div>

      <div class="account-card" id="dashboard-backlog-card" data-testid="dashboard-backlog">
        <h2 class="account-section-title">Backlog</h2>
        <p class="field-help" id="dashboard-backlog-empty" data-testid="dashboard-backlog-empty" hidden>
          Backlog is idle — nothing incomplete.
        </p>
        <ul class="org-list backlog-list" id="dashboard-backlog-list" data-testid="dashboard-backlog-list"></ul>
        <p class="field-help" id="dashboard-backlog-selected" data-testid="dashboard-backlog-selected" hidden></p>
      </div>

      <nav class="account-nav" aria-label="Dashboard links">
        <a href="/account">Account</a>
        <a href="/checkout" data-testid="dashboard-checkout-cta">Start 14-day free trial</a>
        <a href="/billing/manage">Billing</a>
      </nav>

      <div class="form-message" id="dashboard-message" role="status" aria-live="polite"></div>
    </section>
  </div>
</StarlightPage>

<style is:global>
  .license-page { background: var(--rtmx-bg); min-height: 100vh; width: 100%; }
  .license-header { text-align: center; padding: 2rem 1.5rem 0.5rem; }
  .license-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.35rem); font-weight: 700; margin: 0 0 0.75rem;
    background: linear-gradient(135deg, var(--rtmx-emerald) 0%, var(--rtmx-emerald-light) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .license-subtitle { font-size: 1.05rem; color: var(--rtmx-text-muted); max-width: 34rem; margin: 0 auto; line-height: 1.55; }
  .server-fixed { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: var(--rtmx-emerald-light); }
  .license-form-section { max-width: 28rem; margin: 0 auto; padding: 1.25rem 1.25rem 3rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .account-card {
    background: var(--rtmx-bg-card); border: 1px solid var(--rtmx-border); border-radius: 0.75rem; padding: 1.25rem;
  }
  .account-name { margin: 0.25rem 0; font-size: 1.25rem; font-weight: 650; color: var(--rtmx-text); }
  .field-label { color: var(--rtmx-text); font-weight: 600; font-size: 0.9rem; margin: 0; }
  .field-help { color: var(--rtmx-text-dim); font-size: 0.85rem; line-height: 1.45; margin: 0.35rem 0 0; }
  .account-section-title { margin: 0 0 0.5rem; font-size: 1.05rem; color: var(--rtmx-text); }
  .account-nav { display: flex; flex-direction: column; gap: 0.5rem; }
  .account-nav a { color: var(--rtmx-emerald-light); }
  .org-list { list-style: none; padding: 0; margin: 0.75rem 0; }
  .org-list li {
    padding: 0.6rem 0; border-bottom: 1px solid var(--rtmx-border); color: var(--rtmx-text); font-size: 0.9rem;
  }
  .org-list button.org-pick, .org-list button.room-pick {
    background: none; border: none; color: inherit; font: inherit; padding: 0; cursor: pointer; text-align: left; width: 100%;
  }
  .org-list button.org-pick:hover, .org-list button.room-pick:hover { color: var(--rtmx-emerald-light); }
  .org-list li.is-selected { color: var(--rtmx-emerald-light); font-weight: 600; }
  .rooms-header { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .rooms-header .account-section-title { margin: 0; }
  .sync-status {
    margin: 0; font-size: 0.8rem; font-weight: 600; color: var(--rtmx-text-dim);
  }
  .sync-status[data-state="connecting"],
  .sync-status[data-state="reconnecting"] { color: #fbbf24; }
  .sync-status[data-state="connected"] { color: var(--rtmx-emerald-light); }
  .sync-status[data-state="auth-failed"],
  .sync-status[data-state="error"] { color: #f87171; }
  .overview-summary[data-live-updated] { transition: color 0.2s ease; }
  .form-message { color: var(--rtmx-text-muted); font-size: 0.9rem; }
  .form-message.is-error { color: #f87171; }
  .overview-stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; margin: 0.75rem 0;
  }
  .stat { text-align: center; }
  .stat-value { display: block; font-size: 1.25rem; font-weight: 700; color: var(--rtmx-emerald-light); }
  .stat-label { display: block; font-size: 0.7rem; color: var(--rtmx-text-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  .phase-list { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .phase-list li {
    display: flex; justify-content: space-between; gap: 0.75rem;
    padding: 0.35rem 0; border-bottom: 1px solid var(--rtmx-border);
    color: var(--rtmx-text); font-size: 0.85rem;
  }
  .backlog-list li { display: flex; flex-direction: column; gap: 0.15rem; }
  .backlog-list button.backlog-pick {
    background: none; border: none; color: inherit; font: inherit; padding: 0; cursor: pointer; text-align: left; width: 100%;
  }
  .backlog-list button.backlog-pick:hover { color: var(--rtmx-emerald-light); }
  .backlog-list li.is-selected { color: var(--rtmx-emerald-light); }
  .backlog-list li.is-blocked .backlog-id::after {
    content: ' blocked'; font-size: 0.7rem; color: #f87171; font-weight: 600; text-transform: uppercase;
  }
  .backlog-list li.is-claimed { border-left: 2px solid var(--rtmx-emerald-light); padding-left: 0.5rem; }
  .backlog-agent {
    display: inline-block; margin-top: 0.15rem; font-size: 0.72rem; font-weight: 600;
    color: var(--rtmx-emerald-light);
  }
  .backlog-agent::before { content: 'in progress · '; color: var(--rtmx-text-dim); font-weight: 500; }
  .backlog-meta { font-size: 0.75rem; color: var(--rtmx-text-dim); }
  .backlog-id { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-weight: 600; }
</style>

<script define:vars={{ defaultServer }}>
  const SESSION = 'rtmx.session';
  const DEFAULT_ROOM = 'main';
  /** REQ-RT-006: first retry under 5s; backoff capped to avoid storms. */
  const RECONNECT_BASE_MS = 500;
  const RECONNECT_MAX_MS = 5000;
  const server = defaultServer.replace(/\/+$/, '');
  const displayEl = document.getElementById('dashboard-display-name');
  const emailEl = document.getElementById('dashboard-email');
  const orgListEl = document.getElementById('dashboard-org-list');
  const orgEmptyEl = document.getElementById('dashboard-org-empty');
  const roomListEl = document.getElementById('dashboard-room-list');
  const roomEmptyEl = document.getElementById('dashboard-room-empty');
  const selectedOrgEl = document.getElementById('dashboard-selected-org');
  const syncStatusEl = document.getElementById('dashboard-sync-status');
  const message = document.getElementById('dashboard-message');
  const overviewSummaryEl = document.getElementById('dashboard-overview-summary');
  const overviewStatsEl = document.getElementById('dashboard-overview-stats');
  const phaseListEl = document.getElementById('dashboard-phase-list');
  const backlogListEl = document.getElementById('dashboard-backlog-list');
  const backlogEmptyEl = document.getElementById('dashboard-backlog-empty');
  const backlogSelectedEl = document.getElementById('dashboard-backlog-selected');
  const ovComplete = document.getElementById('ov-complete');
  const ovPartial = document.getElementById('ov-partial');
  const ovMissing = document.getElementById('ov-missing');
  const ovPct = document.getElementById('ov-pct');

  /** @type {WebSocket | null} */
  let activeWs = null;
  /** @type {{ id: string, name?: string, slug?: string }[]} */
  let orgs = [];
  /** @type {string | null} */
  let selectedOrgSlug = null;
  /** @type {string | null} */
  let sessionToken = null;
  /** @type {{ org: string, room: string } | null} */
  let liveTarget = null;
  let intentionalClose = false;
  let reconnectAttempt = 0;
  /** @type {ReturnType<typeof setTimeout> | null} */
  let reconnectTimer = null;
  /** @type {ReturnType<typeof setTimeout> | null} */
  let refreshTimer = null;
  /** @type {Record<string, { agent_id: string, agent_name: string }>} */
  let claimsByReq = {};
  /** @type {any[]} */
  let lastBacklogItems = [];

  function readSession() {
    try {
      const parsed = JSON.parse(sessionStorage.getItem(SESSION) || '');
      if (!parsed?.token) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function show(text, kind) {
    if (!message) return;
    message.textContent = text;
    message.className = kind === 'error' ? 'form-message is-error' : 'form-message';
  }

  function setSyncStatus(state, label) {
    if (!syncStatusEl) return;
    syncStatusEl.dataset.state = state;
    syncStatusEl.textContent = label;
  }

  function wsBase() {
    return server.replace(/^https:/, 'wss:').replace(/^http:/, 'ws:');
  }

  function clearReconnectTimer() {
    if (reconnectTimer) {
      clearTimeout(reconnectTimer);
      reconnectTimer = null;
    }
  }

  function closeWs() {
    intentionalClose = true;
    clearReconnectTimer();
    if (activeWs) {
      try {
        activeWs.close(1000, 'client close');
      } catch {
        /* ignore */
      }
      activeWs = null;
    }
  }

  /**
   * REQ-RT-004a/b: sync/CRDT traffic triggers overview+backlog DOM refresh (no reload).
   */
  function scheduleLiveRefresh(token) {
    if (!token) return;
    if (refreshTimer) clearTimeout(refreshTimer);
    refreshTimer = setTimeout(() => {
      refreshTimer = null;
      void Promise.all([loadOverview(token), loadBacklog(token)]).then(() => {
        if (overviewSummaryEl) {
          overviewSummaryEl.dataset.liveUpdated = String(Date.now());
          overviewSummaryEl.classList.add('overview-summary');
        }
      });
    }, 120);
  }

  function parseLiveMessage(data) {
    if (typeof data !== 'string') {
      if (data instanceof ArrayBuffer || (typeof Blob !== 'undefined' && data instanceof Blob)) {
        return { type: 'sync_binary' };
      }
      return null;
    }
    try {
      const msg = JSON.parse(data);
      return msg && typeof msg === 'object' ? msg : { type: 'text' };
    } catch {
      return { type: 'text' };
    }
  }

  /**
   * REQ-RT-005a/c: apply claim/release events to backlog rows without reload.
   */
  function applyClaimEvent(msg) {
    const reqId = msg.req_id || msg.requirement_id || '';
    if (!reqId) return;
    const action = (msg.action || 'claim').toLowerCase();
    if (action === 'release' || action === 'released') {
      delete claimsByReq[reqId];
    } else {
      const agentId = msg.agent_id || msg.holder_id || '';
      const agentName = msg.agent_name || msg.holder_name || msg.display_name || agentId;
      if (!agentId) return;
      claimsByReq[reqId] = { agent_id: agentId, agent_name: agentName };
    }
    renderBacklogItems(lastBacklogItems);
    if (backlogListEl) backlogListEl.dataset.liveClaimAt = String(Date.now());
  }

  function mergeClaimsIntoItem(item) {
    const overlay = claimsByReq[item.req_id];
    if (!overlay) return item;
    return {
      ...item,
      claimed: true,
      agent_id: overlay.agent_id,
      agent_name: overlay.agent_name,
      claimed_by: overlay.agent_name,
    };
  }

  function renderBacklogItems(items) {
    if (!backlogListEl || !backlogEmptyEl || !backlogSelectedEl) return;
    const selectedId = backlogSelectedEl.dataset.reqId || '';
    backlogListEl.innerHTML = '';
    backlogSelectedEl.hidden = true;
    backlogSelectedEl.textContent = '';
    backlogEmptyEl.hidden = items.length > 0;
    backlogEmptyEl.textContent = 'Backlog is idle — nothing incomplete.';
    for (const raw of items) {
      const item = mergeClaimsIntoItem(raw);
      const li = document.createElement('li');
      if (item.blocked) li.classList.add('is-blocked');
      if (item.claimed || item.agent_id) li.classList.add('is-claimed');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'backlog-pick';
      btn.dataset.reqId = item.req_id || '';
      const idSpan = document.createElement('span');
      idSpan.className = 'backlog-id';
      idSpan.textContent = item.req_id || '(unknown)';
      const meta = document.createElement('span');
      meta.className = 'backlog-meta';
      meta.dataset.status = item.status || '';
      meta.textContent =
        (item.priority || '') +
        (item.effort_weeks ? ' · ' + item.effort_weeks + 'w' : '') +
        (item.status ? ' · ' + item.status : '');
      btn.appendChild(idSpan);
      btn.appendChild(meta);
      if (item.claimed || item.agent_id) {
        const agent = document.createElement('span');
        agent.className = 'backlog-agent';
        agent.dataset.testid = 'backlog-agent';
        agent.setAttribute('data-testid', 'backlog-agent');
        agent.dataset.agentId = item.agent_id || '';
        agent.textContent = item.agent_name || item.claimed_by || item.agent_id || 'agent';
        btn.appendChild(agent);
      }
      btn.addEventListener('click', () => {
        for (const row of backlogListEl.querySelectorAll('li')) row.classList.remove('is-selected');
        li.classList.add('is-selected');
        backlogSelectedEl.hidden = false;
        backlogSelectedEl.textContent = 'Selected: ' + (item.req_id || '');
        backlogSelectedEl.dataset.reqId = item.req_id || '';
      });
      li.appendChild(btn);
      backlogListEl.appendChild(li);
      if (selectedId && selectedId === item.req_id) {
        li.classList.add('is-selected');
        backlogSelectedEl.hidden = false;
        backlogSelectedEl.textContent = 'Selected: ' + selectedId;
        backlogSelectedEl.dataset.reqId = selectedId;
      }
    }
  }

  /**
   * REQ-RT-004c / REQ-RT-006a/b: reconnect within 5s with bounded exponential backoff.
   */
  function scheduleReconnect(orgSlug, roomName, token) {
    clearReconnectTimer();
    setSyncStatus('reconnecting', 'Reconnecting…');
    if (syncStatusEl) {
      syncStatusEl.dataset.reconnectAttempt = String(reconnectAttempt + 1);
    }
    const delay = Math.min(RECONNECT_BASE_MS * Math.pow(2, reconnectAttempt), RECONNECT_MAX_MS);
    reconnectAttempt += 1;
    reconnectTimer = setTimeout(() => {
      reconnectTimer = null;
      connectRoom(orgSlug, roomName, token);
    }, delay);
  }

  /**
   * SITE-103: open /sync/{org}/{room}?token=… (browser cannot set Authorization).
   * REQ-RT-004/006: messages refresh overview; drops reconnect with state resync.
   */
  function connectRoom(orgSlug, roomName, token) {
    closeWs();
    intentionalClose = false;
    liveTarget = { org: orgSlug, room: roomName };
    sessionToken = token;
    const isReconnect = reconnectAttempt > 0;
    const url =
      wsBase() +
      '/sync/' +
      encodeURIComponent(orgSlug) +
      '/' +
      encodeURIComponent(roomName) +
      '?token=' +
      encodeURIComponent(token);
    setSyncStatus(isReconnect ? 'reconnecting' : 'connecting', isReconnect ? 'Reconnecting…' : 'Connecting…');
    let ws;
    try {
      ws = new WebSocket(url);
    } catch (err) {
      setSyncStatus('error', 'WebSocket unavailable');
      show('Could not open sync connection.', 'error');
      scheduleReconnect(orgSlug, roomName, token);
      return;
    }
    activeWs = ws;
    ws.binaryType = 'arraybuffer';
    ws.onopen = () => {
      if (activeWs !== ws) return;
      const shouldResync = isReconnect;
      reconnectAttempt = 0;
      setSyncStatus('connected', 'Live · ' + orgSlug + '/' + roomName);
      if (syncStatusEl) {
        delete syncStatusEl.dataset.reconnectAttempt;
      }
      // REQ-RT-006c: after reconnect, pull overview/backlog so UI is not stale/blank.
      if (shouldResync) {
        scheduleLiveRefresh(token);
        if (syncStatusEl) syncStatusEl.dataset.resyncedAt = String(Date.now());
      }
    };
    ws.onmessage = (ev) => {
      if (activeWs !== ws) return;
      const msg = parseLiveMessage(ev.data);
      if (!msg) return;
      if (msg.type === 'claim_event') {
        applyClaimEvent(msg);
        return;
      }
      if (
        msg.type === 'rtm_changed' ||
        msg.type === 'requirements_changed' ||
        msg.type === 'sync_binary' ||
        msg.type === 'text'
      ) {
        scheduleLiveRefresh(token);
      }
    };
    ws.onerror = () => {
      if (activeWs === ws) setSyncStatus('error', 'Connection error');
    };
    ws.onclose = (ev) => {
      if (activeWs !== ws) return;
      activeWs = null;
      const authCodes = new Set([4401, 4403, 4409, 4402]);
      if (authCodes.has(ev.code)) {
        clearReconnectTimer();
        setSyncStatus('auth-failed', ev.reason || 'Authentication failed (' + ev.code + ')');
        show(ev.reason || 'Sync rejected the session (' + ev.code + ').', 'error');
        return;
      }
      if (intentionalClose || ev.code === 1000) {
        setSyncStatus('idle', 'Idle');
        return;
      }
      // Unexpected drop — do not freeze on stale counts (REQ-RT-004c).
      scheduleReconnect(orgSlug, roomName, token);
    };
  }

  async function enrichSessionFromMe(session) {
    try {
      const resp = await fetch(server + '/auth/me', {
        headers: { Authorization: 'Bearer ' + session.token },
      });
      if (resp.status === 401 || resp.status === 403) {
        sessionStorage.removeItem(SESSION);
        return null;
      }
      if (!resp.ok) return session;
      const me = await resp.json();
      const next = {
        ...session,
        user_id: me.id || session.user_id || '',
        email: me.email || session.email || '',
        display_name: me.display_name || session.display_name || '',
        login: me.login || session.login || '',
      };
      sessionStorage.setItem(SESSION, JSON.stringify(next));
      return next;
    } catch {
      return session;
    }
  }

  function renderOrgs(token) {
    orgListEl.innerHTML = '';
    orgEmptyEl.hidden = orgs.length > 0;
    for (const org of orgs) {
      const slug = org.slug || org.id;
      const li = document.createElement('li');
      if (slug === selectedOrgSlug) li.classList.add('is-selected');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'org-pick';
      btn.textContent = (org.name || slug) + ' (' + slug + ')';
      btn.addEventListener('click', () => selectOrg(org, token));
      li.appendChild(btn);
      orgListEl.appendChild(li);
    }
  }

  /**
   * SITE-104: rooms from GET /orgs/{slug}/rooms only — never mixed tenants.
   */
  async function loadRooms(org, token) {
    const slug = org.slug || org.id;
    selectedOrgEl.textContent = 'Showing rooms for ' + (org.name || slug);
    roomListEl.innerHTML = '';
    try {
      const resp = await fetch(server + '/orgs/' + encodeURIComponent(slug) + '/rooms', {
        headers: { Authorization: 'Bearer ' + token },
      });
      if (resp.status === 401 || resp.status === 403) {
        sessionStorage.removeItem(SESSION);
        window.location.replace('/login?next=' + encodeURIComponent('/dashboard'));
        return;
      }
      if (!resp.ok) {
        roomEmptyEl.hidden = false;
        roomEmptyEl.textContent = 'Could not list rooms (' + resp.status + ').';
        setSyncStatus('error', 'Rooms unavailable');
        return;
      }
      const body = await resp.json();
      // Trust only this response's rooms; ignore any foreign payload fields.
      const rooms = Array.isArray(body.rooms) ? body.rooms : [];
      const scoped = rooms.filter((r) => !r.org_slug || r.org_slug === slug);
      roomEmptyEl.hidden = scoped.length > 0;
      roomEmptyEl.textContent = 'No rooms in this org yet.';
      for (const room of scoped) {
        const name = room.name || room.room_key || 'room';
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'room-pick';
        btn.dataset.room = name;
        btn.textContent =
          name + (typeof room.connections === 'number' ? ' · ' + room.connections + ' connected' : '');
        btn.addEventListener('click', () => connectRoom(slug, name, token));
        li.appendChild(btn);
        roomListEl.appendChild(li);
      }
      const target = scoped.length ? scoped[0].name || DEFAULT_ROOM : DEFAULT_ROOM;
      connectRoom(slug, target, token);
    } catch {
      show('Could not reach ' + server + '.', 'error');
      setSyncStatus('error', 'Network error');
    }
  }

  function selectOrg(org, token) {
    selectedOrgSlug = org.slug || org.id;
    renderOrgs(token);
    loadRooms(org, token);
  }

  async function loadOrgs(token) {
    try {
      const resp = await fetch(server + '/orgs', {
        headers: { Authorization: 'Bearer ' + token },
      });
      if (resp.status === 401 || resp.status === 403) {
        sessionStorage.removeItem(SESSION);
        window.location.replace('/login?next=' + encodeURIComponent('/dashboard'));
        return;
      }
      if (!resp.ok) {
        orgEmptyEl.hidden = false;
        orgEmptyEl.textContent = 'Could not list organizations (' + resp.status + ').';
        return;
      }
      const body = await resp.json();
      orgs = body.organizations || [];
      renderOrgs(token);
      if (orgs.length) {
        selectOrg(orgs[0], token);
      } else {
        selectedOrgEl.textContent = '';
        roomEmptyEl.hidden = false;
        setSyncStatus('idle', 'No org selected');
      }
    } catch {
      show('Could not reach ' + server + '.', 'error');
    }
  }

  /**
   * WEB-005: status overview aggregates from GET /api/overview.
   */
  async function loadOverview(token) {
    if (!overviewSummaryEl || !overviewStatsEl || !phaseListEl) return;
    try {
      const resp = await fetch(server + '/api/overview', {
        headers: { Authorization: 'Bearer ' + token },
      });
      if (resp.status === 401 || resp.status === 403) {
        overviewSummaryEl.textContent = 'Sign in required to load overview.';
        overviewStatsEl.hidden = true;
        return;
      }
      if (!resp.ok) {
        overviewSummaryEl.textContent = 'Overview unavailable (' + resp.status + ').';
        overviewStatsEl.hidden = true;
        return;
      }
      const data = await resp.json();
      const total = Number(data.total) || 0;
      const complete = Number(data.complete) || 0;
      const partial = Number(data.partial) || 0;
      const missing = Number(data.missing) || 0;
      const pct = data.completion_percent != null ? Number(data.completion_percent) : 0;
      overviewSummaryEl.textContent =
        complete + ' of ' + total + ' complete · ' + pct + '%';
      ovComplete.textContent = String(complete);
      ovPartial.textContent = String(partial);
      ovMissing.textContent = String(missing);
      ovPct.textContent = pct + '%';
      overviewStatsEl.hidden = false;
      phaseListEl.innerHTML = '';
      const phases = Array.isArray(data.phases) ? data.phases : [];
      for (const phase of phases) {
        const li = document.createElement('li');
        const label = document.createElement('span');
        label.textContent = 'Phase ' + (phase.phase || '?');
        const detail = document.createElement('span');
        detail.textContent =
          (phase.complete || 0) + '/' + (phase.total || 0) +
          ' · ' + (phase.partial || 0) + ' partial · ' + (phase.missing || 0) + ' missing';
        li.appendChild(label);
        li.appendChild(detail);
        phaseListEl.appendChild(li);
      }
    } catch {
      overviewSummaryEl.textContent = 'Could not load overview.';
      overviewStatsEl.hidden = true;
    }
  }

  /**
   * WEB-006 / RT-005: backlog with blocked flag + claim holder identity.
   */
  async function loadBacklog(token) {
    if (!backlogListEl || !backlogEmptyEl || !backlogSelectedEl) return;
    try {
      const resp = await fetch(server + '/api/backlog', {
        headers: { Authorization: 'Bearer ' + token },
      });
      if (resp.status === 401 || resp.status === 403) {
        backlogEmptyEl.hidden = false;
        backlogEmptyEl.textContent = 'Sign in required to load backlog.';
        backlogListEl.innerHTML = '';
        return;
      }
      if (!resp.ok) {
        backlogEmptyEl.hidden = false;
        backlogEmptyEl.textContent = 'Backlog unavailable (' + resp.status + ').';
        backlogListEl.innerHTML = '';
        return;
      }
      const data = await resp.json();
      const items = Array.isArray(data.backlog) ? data.backlog : [];
      // Seed claim overlay from API so REST and live events stay aligned.
      for (const item of items) {
        if (item.claimed && item.agent_id) {
          claimsByReq[item.req_id] = {
            agent_id: item.agent_id,
            agent_name: item.agent_name || item.claimed_by || item.agent_id,
          };
        }
      }
      lastBacklogItems = items;
      renderBacklogItems(items);
    } catch {
      backlogEmptyEl.hidden = false;
      backlogEmptyEl.textContent = 'Could not load backlog.';
      backlogListEl.innerHTML = '';
    }
  }

  (async () => {
    let session = readSession();
    if (!session) {
      window.location.replace('/login?next=' + encodeURIComponent('/dashboard'));
      return;
    }
    session = await enrichSessionFromMe(session);
    if (!session) {
      window.location.replace('/login?next=' + encodeURIComponent('/dashboard'));
      return;
    }
    displayEl.textContent = session.display_name || session.login || session.email || 'Signed in';
    emailEl.textContent = session.email || '';
    await Promise.all([
      loadOrgs(session.token),
      loadOverview(session.token),
      loadBacklog(session.token),
    ]);
  })();
</script>
