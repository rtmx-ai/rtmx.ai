---
/**
 * REQ-SITE-114: Signed-in identity chrome in the site header.
 * REQ-SITE-134: Validate Bearer via GET /auth/me; clear on 401 (honest signed-out).
 * Session is client-only (sessionStorage `rtmx.session`) until a cookie path exists
 * (SITE-135 / ONBOARD-014).
 */
const syncHttpUrl = import.meta.env.PUBLIC_RTMX_SYNC_HTTP_URL || 'https://sync.rtmx.ai';
---

<div
	class="session-chrome"
	id="rtmx-session-chrome"
	data-testid="session-chrome"
	data-sync-url={syncHttpUrl}
>
	<a href="/login" class="session-chrome-link" id="rtmx-session-signin" hidden>Sign in</a>
	<div class="session-chrome-signed-in" id="rtmx-session-signed-in" hidden>
		<a
			href="/account"
			class="session-chrome-identity"
			id="rtmx-session-identity"
			data-testid="session-identity"
		></a>
		<button type="button" class="session-chrome-link session-chrome-signout" id="rtmx-session-signout">
			Sign out
		</button>
	</div>
</div>

<script>
	const SESSION_KEY = 'rtmx.session';
	const chrome = document.getElementById('rtmx-session-chrome');
	const syncUrl = (chrome?.getAttribute('data-sync-url') || 'https://sync.rtmx.ai').replace(/\/$/, '');
	const signIn = document.getElementById('rtmx-session-signin');
	const signedIn = document.getElementById('rtmx-session-signed-in');
	const identity = document.getElementById('rtmx-session-identity');
	const signOut = document.getElementById('rtmx-session-signout');

	function githubLogin(value: string): string | null {
		const match = value
			.trim()
			.match(/^(?:\d+\+)?([^@\s]+)@users\.noreply\.github\.com$/i);
		return match?.[1] || null;
	}

	function identityLabel(session: {
		email?: string;
		display_name?: string;
		login?: string;
	}): string {
		const display = (session.display_name || '').trim();
		const login = (session.login || '').trim();
		const email = (session.email || '').trim();
		if (display && !githubLogin(display) && !/@users\.noreply\.github\.com$/i.test(display)) {
			return display;
		}
		const fromDisplay = githubLogin(display);
		if (fromDisplay) return fromDisplay;
		if (login) return login;
		const fromEmail = githubLogin(email);
		if (fromEmail) return fromEmail;
		if (email && !/@users\.noreply\.github\.com$/i.test(email)) return email;
		return display || login || 'Signed in';
	}

	function readSession(): {
		email?: string;
		display_name?: string;
		token?: string;
		login?: string;
		user_id?: string;
	} | null {
		try {
			const raw = sessionStorage.getItem(SESSION_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw) as {
				email?: string;
				display_name?: string;
				token?: string;
				login?: string;
				user_id?: string;
			};
			if (!parsed?.token) return null;
			return parsed;
		} catch {
			return null;
		}
	}

	function clearSession() {
		sessionStorage.removeItem(SESSION_KEY);
		sessionStorage.removeItem('rtmx.oauth.next');
		sessionStorage.removeItem('rtmx.oauth.provider');
		window.dispatchEvent(new CustomEvent('rtmx:session-cleared'));
	}

	function render() {
		const session = readSession();
		if (!signIn || !signedIn || !identity) return;
		if (session) {
			const label = identityLabel(session);
			identity.textContent = label;
			identity.title = session.email || label;
			signIn.hidden = true;
			signedIn.hidden = false;
		} else {
			signIn.hidden = false;
			signedIn.hidden = true;
			identity.textContent = '';
		}
	}

	/** REQ-SITE-134: confirm token with Sync; soft sign-out on 401. */
	async function validateSession() {
		const session = readSession();
		if (!session?.token) {
			render();
			return;
		}
		// Optimistic chrome while validating (avoids Sign-in flash)
		render();
		try {
			const resp = await fetch(`${syncUrl}/auth/me`, {
				headers: { Authorization: `Bearer ${session.token}` },
			});
			if (resp.status === 401) {
				clearSession();
				render();
				return;
			}
			if (resp.ok) {
				const me = (await resp.json()) as {
					email?: string;
					display_name?: string;
					id?: string;
				};
				// Re-check after await — checkout softSignOut may have cleared mid-flight
				const still = readSession();
				if (!still || still.token !== session.token) {
					render();
					return;
				}
				const next = {
					...still,
					email: me.email || still.email,
					display_name: me.display_name || still.display_name,
					user_id: me.id || still.user_id,
				};
				sessionStorage.setItem(SESSION_KEY, JSON.stringify(next));
				render();
			}
			// Network / 5xx: keep local session; server sliding renew helps when reachable
		} catch {
			// offline / CORS — leave local chrome; pages will soft-fail on API calls
		}
	}

	signOut?.addEventListener('click', () => {
		clearSession();
		render();
		const path = window.location.pathname;
		if (
			path.startsWith('/checkout') ||
			path.startsWith('/dashboard') ||
			path.startsWith('/billing') ||
			path.startsWith('/account') ||
			path.startsWith('/orgs')
		) {
			window.location.assign('/');
		}
	});

	window.addEventListener('rtmx:session-cleared', () => {
		render();
	});

	void validateSession();
</script>

<style>
	.session-chrome {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.875rem;
	}
	.session-chrome-signed-in[hidden],
	.session-chrome-link[hidden] {
		display: none !important;
	}
	.session-chrome-signed-in:not([hidden]) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.session-chrome-identity {
		color: var(--rtmx-text-muted);
		max-width: 12rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		text-decoration: none;
	}
	.session-chrome-identity:hover {
		color: var(--rtmx-emerald-light);
		text-decoration: underline;
	}
	.session-chrome-link {
		color: var(--rtmx-emerald-light);
		text-decoration: none;
		background: none;
		border: none;
		padding: 0;
		font: inherit;
		cursor: pointer;
	}
	.session-chrome-link:hover {
		color: var(--rtmx-text);
		text-decoration: underline;
	}
	.session-chrome-signout {
		color: var(--rtmx-text-dim);
	}
</style>
