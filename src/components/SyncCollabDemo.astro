---
/**
 * How it works — horizontal WIP across a human and heterogeneous agents.
 * REQ-MONO-035a/b / SITE-137/138: not a You↔Cursor-only pair.
 * REQ-MONO-060a / SITE-184: stage only — CLI GIF lives in SyncCliRecording.
 */
---

<section class="sync-demo not-content" data-testid="sync-collab-demo" aria-label="Animated demo of multi-agent Sync collaboration">
  <div class="sync-demo-header">
    <p class="sync-demo-kicker">How it works</p>
    <h2>One backlog. Any agent stack.</h2>
    <p class="sync-demo-lede">
      Humans and agents from different systems — Cursor, Claude Code, Codex,
      Gemini CLI, OpenCode, background subagents — join the same Sync room.
      Claims and status are the project system; no ticket board in the middle.
    </p>
  </div>

  <div class="sync-demo-stage" data-demo-stage>
    <div class="sync-demo-roombar" data-demo-roombar>
      <span class="sync-demo-live" aria-hidden="true"></span>
      <span class="sync-demo-room-label">demo / main</span>
      <div class="sync-demo-presence" aria-label="Clients in the room">
        <span class="sync-demo-avatar you" data-presence="you" title="You">Y</span>
        <span class="sync-demo-avatar cursor" data-presence="cursor" title="Cursor">Cu</span>
        <span class="sync-demo-avatar claude" data-presence="claude" title="Claude Code">Cl</span>
      </div>
    </div>

    <div class="sync-demo-panes" data-panes="3">
      <div class="sync-demo-pane" data-pane="you">
        <div class="sync-demo-pane-header">
          <div class="sync-demo-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="sync-demo-pane-title you">You</span>
        </div>
        <div class="sync-demo-pane-body">
          <div class="sync-demo-line prompt" data-step="1">
            <span class="prompt-sym">$</span>
            <span class="typed" data-type="rtmx sync"></span>
            <span class="cursor">▋</span>
          </div>
          <div class="sync-demo-line ok" data-step="2">Connecting to sync.rtmx.ai/sync/demo/main...</div>
          <div class="sync-demo-line ok" data-step="3">  ✓ joined room</div>
          <div class="sync-demo-line live" data-step="5">
            <span class="tag">LIVE</span> REQ-AUTH-012 claimed by Cursor
          </div>
          <div class="sync-demo-line live" data-step="7">
            <span class="tag">LIVE</span> REQ-API-003 claimed by Claude Code
          </div>
          <div class="sync-demo-line accent" data-step="8">
            Matrix: 2 in flight · next unlocks as they complete
          </div>
        </div>
      </div>

      <div class="sync-demo-pane" data-pane="cursor">
        <div class="sync-demo-pane-header">
          <div class="sync-demo-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="sync-demo-pane-title cursor">Cursor</span>
        </div>
        <div class="sync-demo-pane-body">
          <div class="sync-demo-line prompt" data-step="1">
            <span class="prompt-sym">$</span>
            <span class="typed" data-type="rtmx sync"></span>
            <span class="cursor">▋</span>
          </div>
          <div class="sync-demo-line ok" data-step="2">Connecting to sync.rtmx.ai/sync/demo/main...</div>
          <div class="sync-demo-line ok" data-step="3">  ✓ joined room</div>
          <div class="sync-demo-line dim" data-step="4">Next unblocked: REQ-AUTH-012</div>
          <div class="sync-demo-line prompt" data-step="5">
            <span class="prompt-sym">$</span>
            <span class="typed" data-type="rtmx claim REQ-AUTH-012 --agent-id cursor"></span>
            <span class="cursor mid">▋</span>
          </div>
          <div class="sync-demo-line ok" data-step="6">✓ claimed · publishing to room</div>
          <div class="sync-demo-line dim" data-step="8">Working… tests green</div>
        </div>
      </div>

      <div class="sync-demo-pane" data-pane="claude">
        <div class="sync-demo-pane-header">
          <div class="sync-demo-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="sync-demo-pane-title claude">Claude Code</span>
        </div>
        <div class="sync-demo-pane-body">
          <div class="sync-demo-line prompt" data-step="1">
            <span class="prompt-sym">$</span>
            <span class="typed" data-type="rtmx sync"></span>
            <span class="cursor">▋</span>
          </div>
          <div class="sync-demo-line ok" data-step="2">Connecting to sync.rtmx.ai/sync/demo/main...</div>
          <div class="sync-demo-line ok" data-step="3">  ✓ joined room</div>
          <div class="sync-demo-line dim" data-step="6">
            <span class="tag">LIVE</span> REQ-AUTH-012 claimed by Cursor
          </div>
          <div class="sync-demo-line dim" data-step="7">Next unblocked: REQ-API-003</div>
          <div class="sync-demo-line prompt" data-step="8">
            <span class="prompt-sym">$</span>
            <span class="typed" data-type="rtmx claim REQ-API-003 --agent-id claude"></span>
            <span class="cursor late">▋</span>
          </div>
          <div class="sync-demo-line ok" data-step="9">✓ claimed · parallel WIP</div>
        </div>
      </div>
    </div>

    <ol class="sync-demo-captions" data-demo-captions aria-live="polite">
      <li data-caption="1" class="active">Isolated clients join one Sync room — any agent system.</li>
      <li data-caption="2">Presence shows who is live across stacks.</li>
      <li data-caption="3">Cursor claims the next unblocked requirement.</li>
      <li data-caption="4">Everyone’s matrix updates live — no Slack ping.</li>
      <li data-caption="5">Claude Code takes the next item in parallel. WIP lives in Sync.</li>
    </ol>
  </div>
</section>

<style is:global>
  .sync-demo {
    margin: 0;
    padding: var(--sync-pad-y, 2.5rem) 0;
    border-top: 1px solid rgba(110, 231, 183, 0.1);
  }
  .sync-demo-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 1.75rem;
  }
  .sync-demo-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rtmx-emerald-light, #6ee7b7);
    font-weight: 600;
  }
  .sync-demo-header h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--rtmx-text, #f5f5f4);
  }
  .sync-demo-lede {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--rtmx-text-muted, #a8a29e);
  }

  .sync-demo-stage {
    border-radius: 0.85rem;
    border: 1px solid rgba(110, 231, 183, 0.22);
    background: rgba(14, 12, 10, 0.92);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .sync-demo-roombar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1rem;
    background: #141210;
    border-bottom: 1px solid rgba(110, 231, 183, 0.14);
    font-size: 0.85rem;
    color: #a8a29e;
  }
  .sync-demo-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5);
    opacity: 0.35;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }
  .sync-demo-stage[data-phase="2"] .sync-demo-live,
  .sync-demo-stage[data-phase="3"] .sync-demo-live,
  .sync-demo-stage[data-phase="4"] .sync-demo-live,
  .sync-demo-stage[data-phase="5"] .sync-demo-live {
    opacity: 1;
    animation: sync-pulse 1.6s ease-out infinite;
  }
  @keyframes sync-pulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .sync-demo-room-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #6ee7b7;
    font-weight: 600;
  }
  .sync-demo-presence {
    margin-left: auto;
    display: flex;
    gap: 0.35rem;
  }
  .sync-demo-avatar {
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 700;
    opacity: 0.25;
    transform: scale(0.85);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .sync-demo-avatar.you {
    background: #1e3a2f;
    color: #6ee7b7;
    border: 1px solid rgba(110, 231, 183, 0.4);
  }
  .sync-demo-avatar.cursor {
    background: #1c2433;
    color: #93c5fd;
    border: 1px solid rgba(147, 197, 253, 0.4);
  }
  .sync-demo-avatar.claude {
    background: #2a2218;
    color: #fdba74;
    border: 1px solid rgba(253, 186, 116, 0.45);
  }
  .sync-demo-stage[data-phase="2"] .sync-demo-avatar,
  .sync-demo-stage[data-phase="3"] .sync-demo-avatar,
  .sync-demo-stage[data-phase="4"] .sync-demo-avatar,
  .sync-demo-stage[data-phase="5"] .sync-demo-avatar {
    opacity: 1;
    transform: scale(1);
  }

  .sync-demo-panes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    align-items: stretch;
  }
  @media (max-width: 56rem) {
    .sync-demo-panes { grid-template-columns: 1fr; }
  }

  .sync-demo-pane {
    min-width: 0;
    margin-top: 0; /* Starlight sibling gap must not stagger panes */
    border-right: 1px solid rgba(110, 231, 183, 0.12);
    display: flex;
    flex-direction: column;
  }
  .sync-demo-pane:last-child { border-right: none; }
  @media (max-width: 56rem) {
    .sync-demo-pane { border-right: none; border-bottom: 1px solid rgba(110, 231, 183, 0.12); }
    .sync-demo-pane:last-child { border-bottom: none; }
  }

  .sync-demo-pane-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    background: #1a1714;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    flex-shrink: 0;
  }
  .sync-demo-dots {
    display: flex;
    gap: 5px;
  }
  .sync-demo-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #4b5563;
  }
  .sync-demo-dots span:nth-child(1) { background: #ef4444; }
  .sync-demo-dots span:nth-child(2) { background: #eab308; }
  .sync-demo-dots span:nth-child(3) { background: #22c55e; }
  .sync-demo-pane-title {
    font-size: 0.8rem;
    color: #a8a29e;
    font-weight: 600;
  }
  .sync-demo-pane-title.you { color: #6ee7b7; }
  .sync-demo-pane-title.cursor { color: #93c5fd; }
  .sync-demo-pane-title.claude { color: #fdba74; }

  .sync-demo-pane-body {
    padding: 0.85rem 0.85rem 1.1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.45;
    min-height: 14.5rem;
    color: #d6d3d1;
    flex: 1;
  }
  @media (max-width: 56rem) {
    .sync-demo-pane-body { min-height: 10rem; font-size: 0.78rem; }
  }

  .sync-demo-line {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    margin-bottom: 0.35rem;
    word-break: break-word;
  }
  .sync-demo-line.visible {
    opacity: 1;
    transform: none;
  }
  .sync-demo-line.prompt { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .prompt-sym { color: #6ee7b7; font-weight: 700; }
  .sync-demo-line .cursor {
    color: #6ee7b7;
    animation: sync-blink 1s step-end infinite;
  }
  .sync-demo-line .cursor.hidden { visibility: hidden; }
  @keyframes sync-blink {
    50% { opacity: 0; }
  }
  .sync-demo-line.ok { color: #86efac; }
  .sync-demo-line.dim { color: #78716c; }
  .sync-demo-line.accent { color: #6ee7b7; }
  .sync-demo-line.live {
    color: #e7e5e4;
    padding: 0.35rem 0.5rem;
    border-radius: 0.35rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(110, 231, 183, 0.25);
  }
  .sync-demo-line .tag {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: #059669;
    color: #fff;
  }

  .sync-demo-captions {
    list-style: none;
    margin: 0;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid rgba(110, 231, 183, 0.12);
    display: grid;
    gap: 0.35rem;
    background: #120f0d;
  }
  .sync-demo-captions li {
    font-size: 0.9rem;
    color: #57534e;
    transition: color 0.3s ease;
  }
  .sync-demo-captions li.active {
    color: #e7e5e4;
  }
  .sync-demo-captions li.active::before {
    content: '→ ';
    color: #6ee7b7;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .sync-demo-live { animation: none !important; }
    .sync-demo-line .cursor { animation: none !important; }
    .sync-demo-line {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .sync-demo-avatar {
      opacity: 1 !important;
      transform: none !important;
    }
    .sync-demo-captions li { color: #a8a29e; }
    .sync-demo-captions li:last-child {
      color: #e7e5e4;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-testid="sync-collab-demo"]');
    if (!root) return;
    const stage = root.querySelector('[data-demo-stage]');
    const captions = root.querySelectorAll('[data-demo-captions] li');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce) {
      stage.setAttribute('data-phase', '5');
      root.querySelectorAll('.sync-demo-line').forEach((el) => el.classList.add('visible'));
      root.querySelectorAll('.typed').forEach((el) => {
        el.textContent = el.getAttribute('data-type') || '';
      });
      root.querySelectorAll('.cursor').forEach((el) => el.classList.add('hidden'));
      return;
    }

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    async function typeEl(el, text) {
      if (!el) return;
      el.textContent = '';
      for (let i = 0; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await sleep(22 + Math.random() * 18);
      }
    }

    function showStep(n) {
      root.querySelectorAll(`.sync-demo-line[data-step="${n}"]`).forEach((el) => {
        el.classList.add('visible');
      });
    }

    function setCaption(index) {
      captions.forEach((li, i) => li.classList.toggle('active', i === index));
    }

    function setPhase(n) {
      stage.setAttribute('data-phase', String(n));
    }

    async function run() {
      root.querySelectorAll('.sync-demo-line').forEach((el) => el.classList.remove('visible'));
      root.querySelectorAll('.typed').forEach((el) => { el.textContent = ''; });
      root.querySelectorAll('.sync-demo-line .cursor').forEach((el) => el.classList.remove('hidden'));
      setPhase(1);
      setCaption(0);

      const prompts1 = root.querySelectorAll('.sync-demo-line[data-step="1"]');
      prompts1.forEach((el) => el.classList.add('visible'));
      await Promise.all(
        [...prompts1].map((line) => typeEl(line.querySelector('.typed'), 'rtmx sync'))
      );
      prompts1.forEach((line) => line.querySelector('.cursor')?.classList.add('hidden'));
      await sleep(200);

      showStep(2);
      setPhase(2);
      setCaption(1);
      await sleep(450);

      showStep(3);
      await sleep(550);

      showStep(4);
      setCaption(2);
      setPhase(3);
      const claimCursor = root.querySelector('[data-pane="cursor"] .sync-demo-line[data-step="5"]');
      claimCursor?.classList.add('visible');
      await typeEl(claimCursor?.querySelector('.typed'), 'rtmx claim REQ-AUTH-012 --agent-id cursor');
      claimCursor?.querySelector('.cursor')?.classList.add('hidden');
      await sleep(150);

      showStep(5);
      setCaption(3);
      setPhase(4);
      await sleep(600);

      showStep(6);
      await sleep(500);

      showStep(7);
      setCaption(4);
      setPhase(5);
      const claimClaude = root.querySelector('[data-pane="claude"] .sync-demo-line[data-step="8"]');
      claimClaude?.classList.add('visible');
      await typeEl(claimClaude?.querySelector('.typed'), 'rtmx claim REQ-API-003 --agent-id claude');
      claimClaude?.querySelector('.cursor')?.classList.add('hidden');
      showStep(8);
      showStep(9);
      await sleep(4500);
      run();
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.disconnect();
            run();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(root);
  });
</script>
