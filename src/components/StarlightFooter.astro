---
import Default from '@astrojs/starlight/components/Footer.astro';
import ProductFooter from './ProductFooter.astro';
import LegalLinks from './LegalLinks.astro';
---

<ProductFooter />
<Default {...Astro.props}>
	<slot />
</Default>
{/* Always last: Privacy/Terms even if ProductFooter is scrolled past or demoted */}
<div class="site-legal-bar" data-testid="site-legal-bar">
	<LegalLinks />
</div>

<style>
	.site-legal-bar {
		padding: 0.75rem 1.25rem 1.75rem;
		text-align: center;
	}
</style>
