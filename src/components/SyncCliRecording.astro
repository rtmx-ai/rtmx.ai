---
/**
 * CLI proof recording for /sync — separate job from SyncCollabDemo stage.
 * REQ-MONO-060a / SITE-185: framed as recorded CLI, not a second How-it-works.
 * REQ-MONO-045c: prefer live tape when present; mock GIF fallback.
 */
import fs from 'node:fs';
import path from 'node:path';

const liveRel = 'demo/multi-agent-sync-live.gif';
const mockRel = 'demo/multi-agent-sync.gif';
const liveAbs = path.join(process.cwd(), 'public', liveRel);
const tapeKind = fs.existsSync(liveAbs) ? 'live' : 'mock';
const tapeSrc = tapeKind === 'live' ? `/${liveRel}` : `/${mockRel}`;
---

<section
  class="sync-cli-recording not-content"
  data-testid="sync-cli-recording"
  aria-label="Recorded CLI session of multi-agent Sync"
>
  <div class="sync-cli-recording-header">
    <p class="sync-cli-recording-kicker">Recorded from the CLI</p>
    <h2>What you type</h2>
    <p class="sync-cli-recording-lede">
      Same room story as the panes above — sequential clients joining, claiming,
      and seeing LIVE updates. Exact commands, not a metaphor.
    </p>
  </div>
  <figure class="sync-cli-recording-figure" data-testid="sync-collab-recording">
    <img
      src={tapeSrc}
      data-testid="sync-demo-tape"
      data-tape={tapeKind}
      alt="Terminal recording: You, Cursor, and Claude Code clients joining one Sync room and claiming work in parallel"
      width="1100"
      height="640"
      loading="lazy"
    />
    <figcaption>
      {tapeKind === 'live'
        ? 'Live harness recording'
        : 'Mock harness recording'}
      {' '}— <code>rtmx sync</code> / <code>rtmx claim</code> across You, Cursor, and Claude Code.
    </figcaption>
  </figure>
</section>

<style is:global>
  .sync-cli-recording {
    margin: 0;
    padding: var(--sync-pad-y, 2.5rem) 0 0;
    border-top: 1px solid rgba(110, 231, 183, 0.1);
  }
  .sync-cli-recording-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 1.25rem;
    padding: 0 1rem;
  }
  .sync-cli-recording-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rtmx-emerald-light, #6ee7b7);
    font-weight: 600;
  }
  .sync-cli-recording-header h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--rtmx-text, #f5f5f4);
  }
  .sync-cli-recording-lede {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--rtmx-text-muted, #a8a29e);
  }
  .sync-cli-recording-figure {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .sync-cli-recording-figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid rgba(110, 231, 183, 0.15);
  }
  .sync-cli-recording-figure figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(226, 232, 240, 0.65);
  }
</style>
