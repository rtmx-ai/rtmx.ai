      { text: 'Phase 12 (Dashboard):  100.0%  ✓ Complete  (3✓ 0⚠ 0✗)', color: '#22c55e' },
      { text: 'Phase 26 (Terminal UI):  100.0%  ✓ Complete  (11✓ 0⚠ 0✗)', color: '#22c55e' },
      { text: 'Phase 28 (Web Dashboard):  100.0%  ✓ Complete  (12✓ 0⚠ 0✗)', color: '#22c55e' },
