      { text: '+-----+----------+----------------+--------------------------------------+----------+', color: '#6b7280' },
      { text: '|   2 | ✗        | REQ-ONBD-003   | Homepage funnel: trial then install  | 2 (0)    |', color: '#ef4444' },
      { text: '+-----+----------+----------------+--------------------------------------+----------+', color: '#6b7280' },
      { text: '|   3 | △        | REQ-TRIAL-001   | Team Checkout includes 14-day trial  | 1 (0)    |', color: '#eab308' },
